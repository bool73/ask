                    -- 대표이미지 정보

BEGIN
                        IF R_GOODS.GRP_GOODS_YN = 'N' THEN
SELECT PI.PRD_IMG_ID
     , CASE
           WHEN PI.PRD_IMG_FILE_NM IS NOT NULL THEN '/' || SUBSTR(PI.PRD_ID, 7) || '/' || SUBSTR(PI.PRD_ID, 5, 2) || '/' || SUBSTR(PI.PRD_ID, 3, 2) || '/' || PI.PRD_IMG_FILE_NM || '_200x200.' || NVL(PI.PRD_IMG_FILE_EXTNS, 'jpg')
           ELSE ''
    END
INTO   R_GOODS.GOODS_IMG_ID
    , R_GOODS.IMG_URL
FROM   TB_PD_PRD_IMG PI
WHERE  PI.PRD_ID = R_GOODS.GOODS_NO
  AND    PI.DLG_YN = 'Y'
  AND    PI.USE_YN = 'Y'
  AND    PI.PRD_IMG_FILE_NM IS NOT NULL
  AND    ROWNUM = 1
;
ELSE
                            /* 그룹상품 노출이미지 추출 100: 그룹상품이미지 200: 대표상품이미지 2023.01.04 박장순 추가*/
SELECT PI.PRD_IMG_ID
     , CASE
           WHEN PI.PRD_IMG_FILE_NM IS NOT NULL THEN '/' || SUBSTR(PI.PRD_ID, 7) || '/' || SUBSTR(PI.PRD_ID, 5, 2) || '/' || SUBSTR(PI.PRD_ID, 3, 2) || '/' || PI.PRD_IMG_FILE_NM || '_200x200.' || NVL(PI.PRD_IMG_FILE_EXTNS, 'jpg')
           ELSE ''
    END
INTO   R_GOODS.GOODS_IMG_ID
    , R_GOODS.IMG_URL
FROM   TB_PD_PRD_IMG PI
WHERE  PI.PRD_ID = CASE WHEN T_GOODS(idx).THMIMG_EXPO_TP_CD = '100' THEN  R_GOODS.GOODS_NO
                        ELSE T_GOODS(idx).DLG_GOODS_NO
    END
  AND    PI.DLG_YN = 'Y'
  AND    PI.USE_YN = 'Y'
  AND    PI.PRD_IMG_FILE_NM IS NOT NULL
  AND    ROWNUM = 1
;
END IF;
EXCEPTION WHEN NO_DATA_FOUND THEN
                        R_GOODS.EC_GOODS_YN := 'N';
END;
                    --현시점의 접두어/접미어
BEGIN
SELECT /*+INDEX_DESC(GPS PK_GOODS_PFX_SFX)*/
    PFX_NM
     , PFX_COLOR_CD
     , PFX_FONT_BOLD_YN
     , SFX_CD
     , DISP_STRT_DTIME
     , DISP_END_DTIME
INTO   R_GOODS.PFX_NM
    , R_GOODS.PFX_COLOR_CD
    , R_GOODS.PFX_FONT_BOLD_YN
    , R_GOODS.SFX_CD
    , R_GOODS.PFX_SFX_STRT_DTIME
    , R_GOODS.PFX_SFX_END_DTIME
FROM   TF_GOODS_PFX_SFX GPS
WHERE  DISP_STRT_DTIME <= V_SYS_DTIME
  AND    DISP_END_DTIME > V_SYS_DTIME
  AND    GOODS_NO = R_GOODS.GOODS_NO
  AND    ROWNUM = 1
;
EXCEPTION WHEN NO_DATA_FOUND THEN
                        R_GOODS.PFX_NM := NULL;
                        R_GOODS.PFX_COLOR_CD := NULL;
                        R_GOODS.PFX_FONT_BOLD_YN := 'N';
                        R_GOODS.SFX_CD := NULL;
                        R_GOODS.PFX_SFX_STRT_DTIME := NULL;
                        R_GOODS.PFX_SFX_END_DTIME := NULL;
END;
                    --현시점의 대표단품가격
BEGIN
SELECT TRUNC(UPC.UPRC)
     , PRC_BGN_DTM
     , PRC_END_DTM
INTO   R_GOODS.SALE_PRC
    , R_GOODS.SALE_PRC_STRT_DTIME
    , R_GOODS.SALE_PRC_END_DTIME
FROM   TB_PD_UNT_PRC_CHG UPC
WHERE  UPC.USE_YN = 'Y'
  AND    UPC.PRC_APV_STS_CD = '310'   /*MD팀장승인*/
  AND    V_SYS_DTIME BETWEEN UPC.PRC_BGN_DTM AND UPC.PRC_END_DTM
  AND    UPC.PRD_ID = CASE WHEN R_GOODS.GRP_GOODS_YN = 'N' THEN R_GOODS.GOODS_NO ELSE T_GOODS(idx).DLG_GOODS_NO END /*그룹상품일때 대표상품번호 적용 2023.01.04 박장순 추가*/
  AND    UPC.UNT_ID = T_GOODS(idx).ITEM_NO
  AND    ROWNUM = 1
;
EXCEPTION WHEN NO_DATA_FOUND THEN
                        R_GOODS.SALE_PRC := 0;
                        R_GOODS.SALE_PRC_STRT_DTIME := NULL;
                        R_GOODS.SALE_PRC_END_DTIME := NULL;
END;
                    --현시점의 상품 동영상 등록 여부
BEGIN
SELECT USE_YN
INTO   R_GOODS_EXT.GOODS_VIDEO_REG_YN
FROM TB_PD_PRD_MOV A
WHERE A.PRD_MOV_ID = ( SELECT MAX(PRD_MOV_ID) KEEP(DENSE_RANK FIRST ORDER BY PRD_MOV_ID DESC) AS MID
                       FROM TB_PD_PRD_MOV
                       WHERE PRD_ID = CASE WHEN R_GOODS.GRP_GOODS_YN = 'N' THEN R_GOODS.GOODS_NO ELSE T_GOODS(idx).DLG_GOODS_NO END ) /*그룹상품일때 대표상품번호 적용 2023.01.04 박장순 추가*/
;
EXCEPTION WHEN NO_DATA_FOUND THEN
                        R_GOODS_EXT.GOODS_VIDEO_REG_YN := 'N';
END;
                    --상품기술서내용
                    IF R_GOODS.GRP_GOODS_YN = 'N' THEN  /*일반상품만 상품기술서내용 추출 2023.01.03 박장순 추가*/
                        R_GOODS.GOODS_MNL_CONT := F_GET_GOODS_MNL_CONT(R_GOODS.GOODS_NO);
ELSE
                        R_GOODS.GOODS_MNL_CONT := NULL;
END IF;
                    --다운로드쿠폰
                    R_GOODS.CPN_ID := NULL;
                    R_GOODS.CPN_NM := NULL;
                    R_GOODS.CPN_STRT_DTIME := NULL;
                    R_GOODS.CPN_END_DTIME := NULL;
                    R_GOODS.CPN_RTAMT_TP_CD := NULL;
                    R_GOODS.CPN_DC_RTAMT := 0;
                    --프로모션가격할인
                    R_GOODS.PR_ID := NULL;
                    R_GOODS.PR_NM := NULL;
                    R_GOODS.PR_STRT_DTIME := NULL;
                    R_GOODS.PR_END_DTIME := NULL;
                    R_GOODS.PR_RTAMT_TP_CD := NULL;
                    R_GOODS.PR_DC_RTAMT := 0;
                    -- 프로모션 혜택 유형 2023.01.04 박장순 추가
                    R_GOODS.PMT_PRC_DSN_YN := 'N';
                    R_GOODS.PMT_PNM_YN := 'N';
                    R_GOODS.PMT_GFT_YN := 'N';
                    --정렬항목
                    R_GOODS.SALE_QTY := 0;
                    R_GOODS.CLCK_CNT := 0;
                    R_GOODS.GOODS_ASSMT_CNT := 0;
                    R_GOODS.AVG_STFD_VAL := 0;
                    R_GOODS.TERM_SALE_QTY := 0;
                    R_GOODS.TERM_SALE_QTY_2 := 0;
                    R_GOODS.ALL_CH_TERM_SALE_QTY := 0;
                    -- 기본값 설정 2023.03.23 박장순 추가
                    R_GOODS.WISHLST_CNT := 0;
                    R_GOODS.WISHLST_CNT_90 := 0;
                    R_GOODS.GOODS_ASSMT_CNT_90 := 0;
                    R_GOODS.AVG_STFD_VAL_90 := 0;

                    /**
                     * INSERT TF_GOODS_RETRV
                     */
INSERT INTO TF_GOODS_RETRV VALUES R_GOODS;
--집계 확장테이블 기초데이터 생성
INSERT INTO TF_GOODS_RETRV_EXT
VALUES (
         R_GOODS_EXT.GOODS_NO  /*상품_번호*/
       ,'N'              /*재고 품절 여부*/
       ,SYSDATE          /*재고 품절 수정 일시*/
       ,SYSDATE          /*수정 일자*/
       ,R_GOODS_EXT.GOODS_LCLS_ID          /*상품_대분류_아이디*/
       ,R_GOODS_EXT.GOODS_MCLS_ID          /*상품_중분류_아이디*/
       ,R_GOODS_EXT.GOODS_SCLS_ID          /*상품_소분류_아이디*/
       ,0                           /*주간 판매 포인트*/
       ,'N' /*상품 모든단품 판매가 동일 여부 */
       ,R_GOODS_EXT.TRDIT_MRKT_GOODS_YN /*전통시장 상품 여부*/
       ,R_GOODS_EXT.GOODS_PREP_SHOW_STRT_DTIME   /*상품 준비 노출 시작 일시*/
       ,R_GOODS_EXT.GOODS_PREP_SHOW_END_DTIME    /*상품 준비 노출 종료 일시*/
       ,R_GOODS_EXT.GOODS_VIDEO_REG_YN           /*상품 동영상 등록 여부*/
       ,R_GOODS_EXT.GOODS_DCLS_ID                /*상품_세분류_아이디*/
       );
--기본카테고리에 상품 입력
IF NVL(R_GOODS.D_DISP_CAT_NO, 0) > 0 THEN
                        INSERT INTO TF_DISP_CAT_GOODS_LNK (
                            DISP_CAT_NO, GOODS_NO, DISP_SEQ_NO, DISP_STRT_DTIME, DISP_END_DTIME, REGMN_ID, REG_DTIME, MODMN_ID, MOD_DTIME
                        )
SELECT R_GOODS.D_DISP_CAT_NO,
       R_GOODS.GOODS_NO,
       (SELECT NVL(MAX(DISP_SEQ_NO), 0) + 1
        FROM   TF_DISP_CAT_GOODS_LNK
        WHERE  DISP_CAT_NO = R_GOODS.D_DISP_CAT_NO) AS DISP_SEQ_NO,
       TRUNC(SYSDATE),
       TO_DATE('2999/12/31 00:00:00', 'YYYY/MM/DD HH24:MI:SS'),
       V_USERID, V_SYS_DTIME, V_USERID, V_SYS_DTIME
FROM DUAL
WHERE NOT EXISTS (
    SELECT 1
    FROM   TF_DISP_CAT_GOODS_LNK
    WHERE  DISP_CAT_NO = R_GOODS.D_DISP_CAT_NO
      AND    GOODS_NO = R_GOODS.GOODS_NO
)
;
END IF;
                    V_I_CNT := V_I_CNT + 1;
END IF;
END LOOP;

COMMIT WORK;    --상품정보변경
END IF;
    V_EXE_RSLT := '상품등록:'||V_I_CNT||' 상품수정:'||V_U_CNT;
    V_U_CNT := 0;
OPEN C_HLD_GOODS_LIST;
FETCH C_HLD_GOODS_LIST
    BULK COLLECT INTO T_GOODS_HLD;
CLOSE C_HLD_GOODS_LIST;
IF T_GOODS_HLD.COUNT > 0 THEN
        FOR idx IN T_GOODS_HLD.FIRST .. T_GOODS_HLD.LAST
            LOOP
                R_GOODS := NULL;
                R_GOODS.GOODS_NO := T_GOODS_HLD(idx).GOODS_NO;
SELECT COUNT(1)
INTO   V_CNT
FROM   TF_GOODS_RETRV
WHERE  GOODS_NO = R_GOODS.GOODS_NO
;
IF V_CNT > 0 THEN
UPDATE TF_GOODS_RETRV
SET  DEL_YN = 'Y'
  , MOD_DTIME = V_SYS_DTIME
  , EP_MOD_DTIME = V_SYS_DTIME
WHERE  GOODS_NO = R_GOODS.GOODS_NO
;
V_U_CNT := V_U_CNT + 1;
END IF;
END LOOP;
COMMIT WORK;    --상품정보변경
END IF;
    V_EXE_RSLT := V_EXE_RSLT || '상품수정(승인롤백):'||V_U_CNT;
    V_U_CNT := 0;

OPEN C_PRICE_LIST;
FETCH C_PRICE_LIST
    BULK COLLECT INTO T_PRICE;
CLOSE C_PRICE_LIST;
IF T_PRICE.COUNT > 0 THEN
        FOR idx IN T_PRICE.FIRST .. T_PRICE.LAST
            LOOP
                --무료배송 기준 코드값 체크
BEGIN
SELECT PRD.ORD_DLVF_YN
     ,NVL(TO_NUMBER(CD1.CD_VAL_NM), 0)
     ,F_DLV_STD_CD
     ,NVL(F_DLV_STD_UNIT,0)
INTO V_GOODS_ORD_DLVF_YN
    ,V_GOODS_ORD_DLVF_CD_VAL
    ,V_GOODS_F_DLV_STD_CD
    ,V_GOODS_F_DLV_STD_UNIT
FROM TB_PD_PRD PRD
   , TB_CM_CODE_DTL CD1
WHERE PRD_ID = T_PRICE(idx).GOODS_NO
  AND CD1.CD (+)= 'ORD_DLVF_CD'
  AND PRD.ORD_DLVF_CD = CD1.CD_VAL (+);
EXCEPTION WHEN NO_DATA_FOUND THEN
                    NULL;
END;
                --무료배송 비즈니스 로직
                IF V_GOODS_ORD_DLVF_YN = 'Y' AND V_GOODS_ORD_DLVF_CD_VAL > 0 THEN
                    --        무료배송기준코드 (F_DLV_STD_CD) 값이 200(수량)
                    IF V_GOODS_F_DLV_STD_CD = '200' THEN
                        IF V_GOODS_F_DLV_STD_UNIT <= 1 THEN
                            V_GOODS_FREE_DLV_YN := 'Y';
                            V_GOODS_DLV_COST := 0;
ELSE
                            V_GOODS_FREE_DLV_YN := 'N';
                            V_GOODS_DLV_COST := V_GOODS_ORD_DLVF_CD_VAL;
END IF;
                        --        무료배송기준코드 (F_DLV_STD_CD) 값이 100(금액)
                    ELSIF V_GOODS_F_DLV_STD_CD = '100' THEN
                        IF V_GOODS_F_DLV_STD_UNIT <= 0 THEN
                            V_GOODS_FREE_DLV_YN := 'Y';
                            V_GOODS_DLV_COST := 0;
                        ELSIF V_GOODS_F_DLV_STD_UNIT <= T_PRICE(idx).SALE_PRC THEN
                            V_GOODS_FREE_DLV_YN := 'Y';
                            V_GOODS_DLV_COST := 0;
ELSE
                            V_GOODS_FREE_DLV_YN := 'N';
                            V_GOODS_DLV_COST := V_GOODS_ORD_DLVF_CD_VAL;
END IF;
                        --        무료배송키준코드 (F_DLV_STD_CD) 값이 300 (무조건 유료)
                    ELSIF V_GOODS_F_DLV_STD_CD = '300' THEN
                        V_GOODS_FREE_DLV_YN := 'N';
                        V_GOODS_DLV_COST := V_GOODS_ORD_DLVF_CD_VAL;
END IF;
ELSE
                    V_GOODS_FREE_DLV_YN := 'Y';
                    V_GOODS_DLV_COST := 0;
                    --        무료배송키준코드 (F_DLV_STD_CD) 값이 400 (착불)
                    IF V_GOODS_F_DLV_STD_CD = '400' THEN
                        V_GOODS_COD_YN := 'Y';
ELSE
                        V_GOODS_COD_YN := 'N';
END IF;
END IF;
                -- 단품가격 UPDATE
UPDATE TF_GOODS_RETRV
SET SALE_PRC = T_PRICE(idx).SALE_PRC
  , SALE_PRC_STRT_DTIME = T_PRICE(idx).SALE_PRC_STRT_DTIME
  , SALE_PRC_END_DTIME = T_PRICE(idx).SALE_PRC_END_DTIME
  , ITEM_NO = T_PRICE(idx).ITEM_NO
  , FREE_DLV_YN = V_GOODS_FREE_DLV_YN
  , DLV_COST = V_GOODS_DLV_COST
  , MOD_DTIME = V_SYS_DTIME
  , EP_MOD_DTIME = V_SYS_DTIME
  , COD_YN = V_GOODS_COD_YN
WHERE  GOODS_NO = T_PRICE(idx).GOODS_NO
;
V_U_CNT := V_U_CNT + SQL%ROWCOUNT;
END LOOP;
COMMIT WORK;    --상품가격정보변경
V_EXE_RSLT := V_EXE_RSLT || ' 가격변경:'||V_U_CNT;

END IF;
    V_U_CNT := 0;
OPEN C_UNT_PRICE_GAP_CNT_LIST;
FETCH C_UNT_PRICE_GAP_CNT_LIST
    BULK COLLECT INTO T_UNT_PRICE_GAP_CNT;
CLOSE C_UNT_PRICE_GAP_CNT_LIST;
IF T_UNT_PRICE_GAP_CNT.COUNT > 0 THEN
        FOR idx IN T_UNT_PRICE_GAP_CNT.FIRST .. T_UNT_PRICE_GAP_CNT.LAST
            LOOP
BEGIN        --단품 판매_가 차이 여부 검사
SELECT NVL(
               (CASE WHEN COUNT( DISTINCT UPC.UPRC) > 1 THEN 'Y' ELSE 'N' END)
           ,'N'
       )
INTO V_GOODS_ITEM_SALE_PRC_GAP_YN
FROM TB_PD_UNT UNT, TB_PD_UNT_PRC_CHG UPC
WHERE 1=1
  AND UNT.PRD_ID = T_UNT_PRICE_GAP_CNT(idx).GOODS_NO
  AND UPC.PRD_ID = UNT.PRD_ID
  AND UPC.UNT_ID = UNT.UNT_ID
  AND UPC.USE_YN = 'Y'
  AND UPC.PRC_APV_STS_CD = '310'
  AND UNT.UNT_SL_STS_CD = '110'
  AND UNT.USE_YN = 'Y'
  AND SYSDATE BETWEEN UPC.PRC_BGN_DTM AND UPC.PRC_END_DTM;
EXCEPTION WHEN NO_DATA_FOUND THEN
                    NULL;
END;
                -- 단품판매가 동일 여부 UPDATE
UPDATE TF_GOODS_RETRV_EXT
SET ITEM_SALE_PRC_GAP_YN = V_GOODS_ITEM_SALE_PRC_GAP_YN
WHERE  GOODS_NO = T_UNT_PRICE_GAP_CNT(idx).GOODS_NO;
V_U_CNT := V_U_CNT + SQL%ROWCOUNT;
END LOOP;
COMMIT WORK;    --상품가격정보변경
V_EXE_RSLT := V_EXE_RSLT || ' 단품판매가 동일 여부 수정:'||V_U_CNT;
END IF;
    --판매량, 클릭수, 상품평정보, 좋아요 UPDATE
BEGIN
        -- 총 누적 판매량
UPDATE TF_GOODS_RETRV GR
SET    SALE_QTY = (SELECT NVL(SUM(ORD_QTY), 0)
                   FROM   TF_BATCH_GOODS_ORD MPO
                   WHERE  MPO.GOODS_NO = GR.GOODS_NO
                     AND    MPO.STD_DATE >= TRUNC(V_SYS_DTIME)
                     AND    MPO.ORD_QTY > 0
                     AND    MPO.CHNL_ID IN ('1012','1013')
)
  , MOD_DTIME = V_SYS_DTIME
WHERE  GOODS_NO IN (
    SELECT GOODS_NO
    FROM   TF_BATCH_GOODS_ORD
    WHERE  REG_DTIME >= V_BATCH_STRD_DTIME
      AND    REG_DTIME < V_SYS_DTIME
      AND    ORD_QTY > 0
)
;

V_U_CNT := SQL%ROWCOUNT;
COMMIT WORK;
V_EXE_RSLT := V_EXE_RSLT || ' 일반상품 판매량변경:'||V_U_CNT;

        -- 총 누적 판매량(그룹상품) : 그룹상품 = 'Y' 집계 2023.01.04 박장순 추가
UPDATE TF_GOODS_RETRV GR
SET    SALE_QTY = (SELECT NVL(SUM(ORD_QTY), 0)
                   FROM   TB_PD_GP_PRD_MAPG GPM,
                          TF_BATCH_GOODS_ORD MPO
                   WHERE  GR.GOODS_NO = GPM.GP_PRD_ID
                     AND    MPO.GOODS_NO = GPM.PRD_ID
                     AND    MPO.STD_DATE >= TRUNC(V_SYS_DTIME)
                     AND    MPO.ORD_QTY > 0
                     AND    MPO.CHNL_ID IN ('1012','1013')
)
  , MOD_DTIME = V_SYS_DTIME
WHERE  GR.GOODS_NO IN (SELECT GPM.GP_PRD_ID
                       FROM   TF_BATCH_GOODS_ORD BGO,
                              TB_PD_GP_PRD_MAPG  GPM
                       WHERE  BGO.GOODS_NO = GPM.PRD_ID
                         AND    BGO.REG_DTIME >= V_BATCH_STRD_DTIME
                         AND    BGO.REG_DTIME < V_SYS_DTIME
                         AND    BGO.ORD_QTY > 0
                       GROUP  BY GPM.GP_PRD_ID
)
  AND   GR.GRP_GOODS_YN = 'Y'
;
V_U_CNT := SQL%ROWCOUNT;
COMMIT WORK;
V_EXE_RSLT := V_EXE_RSLT || ' 그룹상품 판매량변경:'||V_U_CNT;

        -- 아임딜 90일 누적 판매량 (아임딜 기간 변경시 추후 변경 부분) -- 일반상품 TF_GOODS_RETRV.GRP_GOODS_YN = 'N'
UPDATE TF_GOODS_RETRV GR
SET    TERM_SALE_QTY_2 = (SELECT NVL(SUM(ORD_QTY), 0)
                          FROM   TF_BATCH_GOODS_ORD MPO
                          WHERE  MPO.GOODS_NO = GR.GOODS_NO
                            AND    MPO.STD_DATE >= TRUNC(V_SYS_DTIME) - 90
                            AND    MPO.ORD_QTY > 0
                            AND    MPO.CHNL_ID IN ('1012','1013')
)
  , MOD_DTIME = V_SYS_DTIME
WHERE GR.GRP_GOODS_YN = 'N'
  AND   SYSDATE BETWEEN GR.DEAL_APLY_STRT_DTIME AND GR.DEAL_APLY_END_DTIME
;
V_U_CNT := SQL%ROWCOUNT;
COMMIT WORK;
V_EXE_RSLT := V_EXE_RSLT || ' 아임딜(90일)판매량변경(일반상품):'||V_U_CNT;

        -- 아임딜 90일 누적 판매량 (아임딜 기간 변경시 추후 변경 부분) -- 그룹상품 TF_GOODS_RETRV.GRP_GOODS_YN = 'Y'
UPDATE TF_GOODS_RETRV GR
SET    TERM_SALE_QTY_2 = (SELECT NVL(SUM(ORD_QTY), 0)
                          FROM   TF_BATCH_GOODS_ORD  MPO
                             , TB_PD_GP_PRD_MAPG   GPM
                          WHERE  GR.GOODS_NO  = GPM.GP_PRD_ID
                            AND    MPO.GOODS_NO = GPM.PRD_ID
                            AND    MPO.STD_DATE >= TRUNC(V_SYS_DTIME) - 90
                            AND    MPO.ORD_QTY > 0
                            AND    MPO.CHNL_ID IN ('1012','1013')
)
  , MOD_DTIME = V_SYS_DTIME
WHERE GR.GRP_GOODS_YN = 'Y'
  AND   SYSDATE BETWEEN GR.DEAL_APLY_STRT_DTIME AND GR.DEAL_APLY_END_DTIME
;
V_U_CNT := SQL%ROWCOUNT;
COMMIT WORK;
V_EXE_RSLT := V_EXE_RSLT || ' 아임딜(90일)판매량변경(그룹상품):'||V_U_CNT;

        IF TO_CHAR(V_SYS_DTIME, 'HH24') = '06' THEN --오전6시에만 처리
UPDATE TF_GOODS_RETRV GR
SET    CLCK_CNT = 0
  , MOD_DTIME = V_SYS_DTIME
WHERE CLCK_CNT > 0
;
COMMIT WORK;

MERGE INTO TF_GOODS_RETRV GR
    USING (
        SELECT                 GOODS_NO , NVL(SUM(CLCK_CNT), 0) as CLCK_CNT
        FROM                        TF_DD_GOODS_WEB_LOG
        WHERE                LOG_DATE >= TRUNC(V_SYS_DTIME) - 7
          AND                    CLCK_CNT > 0
        GROUP BY         GOODS_NO
    ) C
    ON (GR.GOODS_NO = C.GOODS_NO)
    WHEN MATCHED THEN
        UPDATE SET GR.CLCK_CNT = C.CLCK_CNT
;
COMMIT WORK;
SELECT                 COUNT(1)
INTO      V_U_CNT
