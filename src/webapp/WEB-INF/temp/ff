    FUNCTION F_GET_GOODS_MNL_CONT (P_GOODS_NO IN VARCHAR2)
        RETURN CLOB
        IS
        V_MNL_CONT TF_GOODS_RETRV.GOODS_MNL_CONT%TYPE;
BEGIN
        V_MNL_CONT := '';
FOR IDX IN (
            SELECT CASE WHEN MNL.MNL_ENT_SP_CD = '100'
                            THEN (SELECT MNL_ARC_DTL_NM
                                  FROM   TB_PD_MNL_ARC_DTL DTL
                                  WHERE  DTL.MNL_ARC_ID = MNL.ARC_ID
                                    AND    DTL.MNL_ARC_DTL_ID = MNL.CONT
                                    AND    DTL.USE_YN = 'Y')
                        ELSE MNL.CONT
                       END AS CONT
            INTO   R_GOODS.GOODS_MNL_CONT
            FROM   TB_PD_PRD_MNL MNL
               , TB_PD_MNL_ARC ARC
            WHERE  MNL.USE_YN = 'Y'
              AND    MNL.WEB_EXPO_YN = 'Y'
              AND    MNL.CST_EXPO_YN = 'Y'
              AND    MNL.MNL_SRCH_TYP_CD != '130'
              AND    MNL.ARC_ID = ARC.MNL_ARC_ID
              AND    ARC.USE_YN = 'Y'
              AND    MNL.PRD_ID = P_GOODS_NO
            ) LOOP
                V_MNL_CONT := V_MNL_CONT || IDX.CONT;
END LOOP;
RETURN V_MNL_CONT;
END F_GET_GOODS_MNL_CONT;

