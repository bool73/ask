create or replace PROCEDURE        SP_GOODS_RETRV (
    in_strd_dtime in varchar2 default null
)
/*******************************************************************************
 Object Name : SP_GOODS_RETRV
 Writer      : YHSEO
 Write Date  : 2015/06/24
 Usage       : 전시상품자료 생성
 history     : 2015.09.17 EC_GOODS_YN 용도변경=>대표이미지 있는경우만 Y 아닌경우 EC 노출불가
               2015.09.18 프로모션, 쿠폰 정액 할인금액이 판매가보다 클경우 적용않기
               2015.10.17 판매매체에 관계없이 상품데이터 생성 후 수정
               2015.10.29 실행중배치 체크 추가
               2016.01.25 온라인 상품테이블 분리 작업
               2016.02.15 제품유형코드 컬럼 추가
               2016.02.25 웹로그 클릭수 현재기준 -7 일로 전상품 수정
               2016.03.02 랜탈상품 데이터 추가 및 배송 특성 코드 추가
               2016.03.24 MD ID 추가
               2016.04.19 승인상태(PRD_APV_STS_CD) 코드값 310(MD팀장승인) 에서 110(MD등록) 상태로 자유변경이 가능토록 기간계 변경으로 해당 로직 추가
               2016.05.27 무료배송 기준 오류 수정
               2016.08.25 아임딜 판매수량 수집기간 14일 => 90일로 변경
               2016.08.25 쿠폰 집계 조회조건 수정
               2016.08.26 쿠폰 및 프로모션 상품 분류 발행제한 조건절 오류 수정
               2016.09.26 온라인 쿠폰 타입 조건 추가 (AND    CPN.CPN_ONL_PATTN_CD = '100')
               2016.12.21 무료배송비 부과 기준코드 300(무조건 유료배송) 추가
               2016.12.27 임직원 상품여부 컬럼 추가 및 쿼리 튜닝
               2017.01.13 프로모션 최대가 제한여부 및 최대할인금액 추가
               2017.01.13 쿠폰 할인 적용시 프로모션 최대할인금액 로직 추가
               2017.02.21 엔진페이지 제외 여부 항목 추가
               2017.03.08 쿠폰 협력사 관련 협력사_구분_코드 컬럼 코드 추가 (AND    CPS.SUPP_TYP_CD = '100')
               2017.03.09 ARS 할인내역 변경된 데이터가 있을 경우에만 Update 처리
               2017.03.10 모바일 할인 제외 여부 컬럼 추가
               2017.03.20 엔진페이지 대상 컬럼변경시 EP_MOD_DTIME 컬럼 Update 처리
               2017.04.25 전시 재고 0 상품 품절표시를 위한 확장테이블 추가 관련 건 처리
               2017.05.25 상품형태코드 (PRD_SP_CD) 컬럼 추가
               2017.07.19 모바일 적립금 제외 여부 (MOBILE_PNM_EXCL_YN) 컬럼 추가
               2017.08.28 기간계 상품분류(대/중) 컬럼 추가
               2017.12.08 단품 판매_가 차이 여부 (ITEM_SALE_PRC_GAP_YN) 컬럼 추가
               2018.01.04 배송비 착불 시 무료배송으로 처리
               2018.05.11 상품집계 프로시저 중 클릭수 SQL 쿼리 튜닝
               2018.05.14 2월달 개발 브랜드그룹 로직 원복화
               2018.05.30 단품 판매_가 차이 여부 중 일부 단품가만 변경시 로직 결함 수정
               2018.11.20 상품 집계 반영시 판매 채널을 고려하지 않고 변경 사항 업데이트 처리로 로직 변경
               2018.11.28 브랜드ID => 브랜드그룹 으로 변경
               2019.05.20 온라인_상품_검색명 6컬럼 추가
               2020.02.12 #25260 상품수정시 MD등록 상태이며 판매가능(110) 인 경우 조회조건을 마지막으로 이동. 노출제외채널 기준을 2번째로 이동
               2020.03.18 #25193 프로모션 전시 Data 시작/종료시간 집계 개발(프로시저수정_시작 / 종료일 시간 설정)
               2020.10.07 #28655  EC/MC 상품리스트 할인율/할인가 표기 개선 요청 (대량주문 프로모션 제외)
               2020.11.10 온라인리뉴얼 전통시장 상품여부
               2021.01.10 온라인리뉴얼 상품준비노출일시, 상품동영상등록여부 컬럼 추가
               2021.01.10 #31013 MLC 상품 여부 집계테이블 반영 요청 건 컬럼 추가.
               2021.04.12 #32322 상품운영형태 컬럼 추가
               2022.05.04 #39161 상품집계배치 (SP_GOODS_RETRV) 기능 수정건 (클릭수 초기화 로직 수정)
               2022.11.18 좋아요 횟수 컬럼 추가
               2022.12.05 TF_GOODS_RETRV_EXT.GOODS_DCLS_ID 컬럼 추가
               2023.01.03 그룹상품 추가
               2023.01.04 프로모션 혜택상품
               2023.03.16 프로모션 혜택상품 수정일자,엔진수정일자 컬럼 UPDATE, 변경항목 UPDATE 조건 추가
               2025.03.24 #71463 알뜰/리퍼 상품 기능의 건 (상품특성 코드 추가)
*******************************************************************************/
    IS
    V_BATCH_STRD_DTIME DATE;    --검색시작일시
    V_SYS_DTIME DATE;           --검색종료일시
    V_CNT NUMBER := 0;
    V_I_CNT NUMBER := 0;
    V_U_CNT NUMBER := 0;
    V_USERID VARCHAR2(7) := '9999991';--FOBATCH
    --BATCH 실행결과
    V_EXE_RSLT_CD TF_BATCH_EXE_HIS.EXE_RSLT_CD%TYPE;
    V_EXE_RSLT TF_BATCH_EXE_HIS.EXE_RSLT%TYPE;
    V_GOODS_MNL_CONT    TF_GOODS_RETRV.GOODS_MNL_CONT%TYPE;
    V_TEMP_SALE_PRC NUMBER := 0;
    V_GOODS_ORD_DLVF_YN       TB_PD_PRD.ORD_DLVF_YN%TYPE;
    V_GOODS_ORD_DLVF_CD_VAL NUMBER := 0;
    V_GOODS_F_DLV_STD_CD      TB_PD_PRD.F_DLV_STD_CD%TYPE;
    V_GOODS_F_DLV_STD_UNIT    TB_PD_PRD.F_DLV_STD_UNIT%TYPE;
    V_GOODS_FREE_DLV_YN VARCHAR2(1) := 'N';
    V_GOODS_DLV_COST NUMBER := 0;
    V_GOODS_COD_YN VARCHAR2(1) := 'N';
    V_GOODS_ITEM_SALE_PRC_GAP_YN VARCHAR2(1) := 'N';

    --상품변경정보 조회 커서
CURSOR C_GOODS_LIST IS
SELECT
    PRD.PRD_ID AS GOODS_NO /*상품ID*/
     , PRDONL.ONL_PRD_NM AS GOODS_NM /*상품명 - 일단 온라인 상품명으로 모두 가져 옴 추후 필요시 PRD_NM 마이그레이션 */
     , UNT.UNT_ID AS ITEM_NO
     , PRD.PRD_SL_STS_CD AS SALE_STAT_CD /*상품판매상태코드*/ /*100 판매준비 110 판매가능 120 일시품절 130 판매불가*/
--             , DECODE(PRD.ORD_DLVF_YN, 'N', 'Y', 'N') AS FREE_DLV_YN /*무료배송여부*/
     , PRD.ORD_DLVF_YN          /*주문배송비여부 N=무료*/
     , NVL(TO_NUMBER(CD1.CD_VAL_NM), 0) AS ORD_DLVF_CD_VAL  /*주문배송비코드값-배송비*/
     , PRD.F_DLV_STD_CD                 /*무료배송기준코드*/
     , PRD.F_DLV_STD_UNIT               /*무료배송기준단위*/
     , PRD.DLVF_IMPOSE_STD_CD           /*배송비부과기준코드*/
     , PRD.DLVF_IMPOSE_STD_UNIT         /*배송비부과기준단위*/
     , PRD.INTF_INTT_YN /*무이자할부*/
     , PRD.INTF_INTT_MMS /*무이자할부개월수*/
     , PRD.DEAL_PRD_YN AS DEAL_GOODS_YN /*딜상품여부*/
     , DECODE(NVL(PRD.ONL_PRD_YN, 'N'), 'N', 'Y', 'N') AS TV_GOODS_YN
     , 'Y' AS EC_GOODS_YN
     , PRD.SUPP_ID /*협력사ID*/
     , SUPP.SUPP_NM /*협력사명*/
     , BRND.BRND_GP_ID AS BRND_ID /*브랜드ID*/
     , BRND.BRND_GP_NM AS BRND_NM /*브랜드명*/
     , PRD.PRD_LCLS_ID AS GOODS_LCLS_ID  /* 영업시스템 대분류 */
     , PRD.PRD_MCLS_ID AS GOODS_MCLS_ID  /* 영업시스템 중분류 */
     , PRD.PRD_SCLS_ID AS GOODS_SCLS_ID  /* 영업시스템 소분류 */
     , PRD.PRD_DCLS_ID AS GOODS_CLS_ID  /* 영업시스템 세분류 */
     , PRD.SRCH_WRD AS RETRV_WD /*검색어*/
     , PRD.INST_DTM AS GOODS_REG_DTIME /*상품등록일자*/
     , PRD.DLV_MTD_CD /*배송방법코드*/
     , PRDONL.ONL_PRD_NM AS ONL_GOODS_NM /*온라인 상품명*/
     , PRDONL.DEAL_APPLY_BGN_DTM AS DEAL_APLY_STRT_DTIME /*딜 적용 시작일시*/
     , PRDONL.DEAL_APPLY_END_DTM AS DEAL_APLY_END_DTIME /*딜 적용 종료일시*/
     , PRDONL.MAX_ORD_PSS_QTY AS MAX_ORD_PSB_QTY /*최대_주문_가능_수량*/
     , PRDONL.INSD_SRCH_EXPT_YN AS INSD_RETRV_EXCL_YN /*내부_검색_제외_여부*/
     , PRDONL.ONL_PRD_TYP_CD /*온라인상품구분코드*/
     , PRD.MANPRD_PATTN_CD /*제품유형코드*/
     , PRD.DLV_CHRC_CD  /* 배송특성코드 */
     , PRD.MD_ID /* MD코드 */
     , NVL(PRD.ECVEMP_PRD_YN,'N') AS EMP_GOODS_YN /* 임직원_상품_여부 */
     , PRD.EP_EXPT_YN AS EP_EXCL_YN /* 엔진페이지 제외 여부 */
     , PRDONL.MOBILE_DSN_EXPT_YN AS MOBILE_DC_EXCL_YN /* 모바일 할인 제외 여부 */
     , PRD.PRD_SP_CD AS GOODS_SP_CD  /* 상품_형태_코드 */
     , PRDONL.MOBILE_PNM_EXPT_YN  AS MOBILE_PNM_EXCL_YN  /* 모바일 적립금 제외 여부  */
     ,'N' AS COD_YN /* 배송비 착불 시 무료배송으로 처리  */
     , PRDONL.ONL_PRD_SRCH_1_NM  AS ONL_GOODS_RETRV_WD_1  /* 온라인_상품_검색_1_명  */
     , PRDONL.ONL_PRD_SRCH_2_NM  AS ONL_GOODS_RETRV_WD_2  /* 온라인_상품_검색_2_명  */
     , PRDONL.ONL_PRD_SRCH_3_NM  AS ONL_GOODS_RETRV_WD_3  /* 온라인_상품_검색_3_명  */
     , PRDONL.ONL_PRD_SRCH_4_NM  AS ONL_GOODS_RETRV_WD_4  /* 온라인_상품_검색_4_명  */
     , PRDONL.ONL_PRD_SRCH_5_NM  AS ONL_GOODS_RETRV_WD_5  /* 온라인_상품_검색_5_명  */
     , PRDONL.ONL_PRD_SRCH_6_NM  AS ONL_GOODS_RETRV_WD_6  /* 온라인_상품_검색_6_명  */
     , SUPP.TRAD_MRKT_SUPP_YN  AS TRDIT_MRKT_GOODS_YN     /* 전통시장 상품 여부  */
     , PRDONL.PRD_PEAR_EXPO_BGN_DTM  AS GOODS_PREP_SHOW_STRT_DTIME  /* 상품준비 노출 시작일시 */
     , PRDONL.PRD_PEAR_EXPO_END_DTM   AS GOODS_PREP_SHOW_END_DTIME  /* 상품준비 노출 종료일시 */
     , PRD.PRD_TYP_CD  AS GOODS_SCT_CD  /* 상품 구분 코드 (MLC 상품구분 컬럼) */
     , PRD.PRD_OPR_SP_CD  AS GOODS_OPER_SP_CD  /* 상품 운영 형태 코드 */
     , 'N' AS GRP_GOODS_YN  /*그룹상품 여부 */ -- 2023.01.04 박장순 추가
     , NULL AS THMIMG_EXPO_TP_CD /*썸네일 노출유형 코드 2023.01.04 박장순 추가 */
     , NULL AS DLG_GOODS_NO /*대표상품 PRD_ID 2023.01.04 박장순 추가 */
     , PRD.PRD_CHRC_CD AS GOODS_CHRC_CD /*상품 특성 코드 100일반, 200알뜰, 300리퍼*/
FROM   TB_PD_PRD PRD
   , TB_PD_UNT UNT
   , V_PD_BRAND BRND
   , TB_PD_SUPP SUPP
   , TB_CM_CODE_DTL CD1
   , TB_PD_PRD_ONL_DTL PRDONL
WHERE  PRD.USE_YN = 'Y' /*상품사용여부*/
  AND    PRD.PRD_APV_STS_CD = '310' /*상품승인상태코드 MD팀장승인*/
  AND    PRD.PRD_SL_STS_CD > '100' /*상품판매상태코드*/
  AND    PRD.ADD_COMP_PRD_YN = 'N' /*추가구성상품여부*/
  AND    PRD.PRD_PATTN_CD IN ('100','300') /*100 일반, 200 사은품, 300 특수상품*/
  AND    PRD.PRD_ID = UNT.PRD_ID  /*대표단품번호*/
  AND    UNT.USE_YN = 'Y'
  AND    UNT.DLG_UNT_YN = 'Y'
  AND    PRD.PRD_ID = PRDONL.PRD_ID
  AND    PRD.BRND_ID = BRND.BRND_ID (+)
  AND    PRD.SUPP_ID = SUPP.SUPP_ID (+)
  AND    CD1.CD (+)= 'ORD_DLVF_CD'
  AND    PRD.ORD_DLVF_CD = CD1.CD_VAL (+)
  --검색조건 (상품에 변경사항(신규등록 또는 수정)이 발생한경우)
  AND (
    (    PRD.MDF_DTM >= V_BATCH_STRD_DTIME
        AND    PRD.MDF_DTM < V_SYS_DTIME
        )
        OR
    (
        UNT.MDF_DTM >= V_BATCH_STRD_DTIME   --대표단품에 변경사항이 생긴경우
            AND    UNT.MDF_DTM < V_SYS_DTIME
        )
        OR
    (
        PRDONL.MDF_DTM >= V_BATCH_STRD_DTIME   --온라인 상품정보에 변경사항이 생긴경우
            AND    PRDONL.MDF_DTM < V_SYS_DTIME
        )
        OR
    (
        BRND.MDF_DTM >= V_BATCH_STRD_DTIME   --브랜드 정보(VIEW)에 변경사항이 생긴경우
            AND    BRND.MDF_DTM < V_SYS_DTIME
        )
        OR
    (
        SUPP.TRAD_MRKT_MDF_DTM >= V_BATCH_STRD_DTIME   --협력사 정보(VIEW)에 전통시장여부 변경사항이 생긴경우
            AND    SUPP.TRAD_MRKT_MDF_DTM < V_SYS_DTIME
        )
        OR
    (
        SUPP.TRAD_MRKT_MDF_DTM >= V_BATCH_STRD_DTIME   --협력사 정보(VIEW)에 전통시장여부 변경사항이 생긴경우
            AND    SUPP.TRAD_MRKT_MDF_DTM < V_SYS_DTIME
        )
    )
UNION ALL
/* 그룹상품 가격변동정보 추출 추가 2023.01.04 박장순 추가 */
SELECT
    GPD.GP_PRD_ID AS GOODS_NO /*그룹상품ID*/
     , GPD.ONL_PRD_NM AS GOODS_NM /*상품명 - 일단 온라인 상품명으로 모두 가져 옴 추후 필요시 PRD_NM 마이그레이션 */
     , NULL AS ITEM_NO
     , CASE WHEN GPD.USE_YN = 'Y'
    AND DP_YN = 'Y'
    AND V_SYS_DTIME BETWEEN GPD.DP_BGN_DTM AND GPD.DP_END_DTM THEN '110'
            ELSE '130' END AS SALE_STAT_CD  /*그룹상품 판매상코드 추출 2023.01.04 박장순 추가 SL_STS_CD ::  (110)판매가능, (130)판매불가 - 그룹상품: 사용여부 + 전시여부 + 전시일자*/
--             , DECODE(PRD.ORD_DLVF_YN, 'N', 'Y', 'N') AS FREE_DLV_YN /*무료배송여부*/
     , PRD.ORD_DLVF_YN          /*주문배송비여부 N=무료*/
     , NVL(TO_NUMBER(CD1.CD_VAL_NM), 0) AS ORD_DLVF_CD_VAL  /*주문배송비코드값-배송비*/
     , PRD.F_DLV_STD_CD                 /*무료배송기준코드*/
     , PRD.F_DLV_STD_UNIT               /*무료배송기준단위*/
     , PRD.DLVF_IMPOSE_STD_CD           /*배송비부과기준코드*/
     , PRD.DLVF_IMPOSE_STD_UNIT         /*배송비부과기준단위*/
     , PRD.INTF_INTT_YN /*무이자할부*/
     , PRD.INTF_INTT_MMS /*무이자할부개월수*/
     , PRD.DEAL_PRD_YN AS DEAL_GOODS_YN /*딜상품여부*/
     , DECODE(NVL(PRD.ONL_PRD_YN, 'N'), 'N', 'Y', 'N') AS TV_GOODS_YN
     , 'Y' AS EC_GOODS_YN
     , PRD.SUPP_ID /*협력사ID*/
     , SUPP.SUPP_NM /*협력사명*/
     , NULL AS BRND_ID /*브랜드ID*/
     , NULL AS BRND_NM /*브랜드명*/
     , GPD.PRD_LCLS_ID AS GOODS_LCLS_ID  /* 영업시스템 대분류 */
     , GPD.PRD_MCLS_ID AS GOODS_MCLS_ID  /* 영업시스템 중분류 */
     , GPD.PRD_SCLS_ID AS GOODS_SCLS_ID  /* 영업시스템 소분류 */
     , GPD.PRD_DCLS_ID AS GOODS_CLS_ID  /* 영업시스템 세분류 */
     , NULL AS RETRV_WD /*검색어*/
     , GPD.INST_DTM AS GOODS_REG_DTIME /*상품등록일자*/
     , PRD.DLV_MTD_CD /*배송방법코드*/
     , GPD.ONL_PRD_NM AS ONL_GOODS_NM /*온라인 상품명*/
     , GPD.DEAL_APPLY_BGN_DTM AS DEAL_APLY_STRT_DTIME /*딜 적용 시작일시*/
     , GPD.DEAL_APPLY_END_DTM AS DEAL_APLY_END_DTIME /*딜 적용 종료일시*/
     , 0 AS MAX_ORD_PSB_QTY /*최대_주문_가능_수량*/
     , NULL AS INSD_RETRV_EXCL_YN /*내부_검색_제외_여부*/
     , '100' AS ONL_PRD_TYP_CD /*온라인상품구분코드*/
     , '100' AS MANPRD_PATTN_CD /*제품유형코드*/
     , PRD.DLV_CHRC_CD  /* 배송특성코드 */
     , PRD.MD_ID /* MD코드 */
     , NVL(PRD.ECVEMP_PRD_YN,'N') AS EMP_GOODS_YN /* 임직원_상품_여부 */
     , 'N' AS EP_EXCL_YN /* 엔진페이지 제외 여부 */
     , 'N' AS MOBILE_DC_EXCL_YN /* 모바일 할인 제외 여부 */
     , '100' AS GOODS_SP_CD  /* 상품_형태_코드 */
     , NULL  AS MOBILE_PNM_EXCL_YN  /* 모바일 적립금 제외 여부  */
     ,'N' AS COD_YN /* 배송비 착불 시 무료배송으로 처리  */
     , GPD.ONL_PRD_SRCH_1_NM  AS ONL_GOODS_RETRV_WD_1  /* 온라인_상품_검색_1_명  */
     , GPD.ONL_PRD_SRCH_2_NM  AS ONL_GOODS_RETRV_WD_2  /* 온라인_상품_검색_2_명  */
     , GPD.ONL_PRD_SRCH_3_NM  AS ONL_GOODS_RETRV_WD_3  /* 온라인_상품_검색_3_명  */
     , GPD.ONL_PRD_SRCH_4_NM  AS ONL_GOODS_RETRV_WD_4  /* 온라인_상품_검색_4_명  */
     , GPD.ONL_PRD_SRCH_5_NM  AS ONL_GOODS_RETRV_WD_5  /* 온라인_상품_검색_5_명  */
     , GPD.ONL_PRD_SRCH_6_NM  AS ONL_GOODS_RETRV_WD_6  /* 온라인_상품_검색_6_명  */
     , SUPP.TRAD_MRKT_SUPP_YN  AS TRDIT_MRKT_GOODS_YN     /* 전통시장 상품 여부  */
     , NULL  AS GOODS_PREP_SHOW_STRT_DTIME  /* 상품준비 노출 시작일시 */
     , NULL   AS GOODS_PREP_SHOW_END_DTIME  /* 상품준비 노출 종료일시 */
     , PRD.PRD_TYP_CD  AS GOODS_SCT_CD  /* 상품 구분 코드 (MLC 상품구분 컬럼) */
     , '100'  AS GOODS_OPER_SP_CD  /* 상품 운영 형태 코드 */
     , 'Y' AS GRP_GOODS_YN  /*그룹상품 여부 */ -- 2023.01.04 박장순 추가
     , GPD.THMIMG_EXPO_TP_CD AS THMIMG_EXPO_TP_CD /*썸네일 노출유형 코드 2023.01.04 박장순 추가 */
     , GPM.PRD_ID AS DLG_GOODS_NO /*대표상품 PRD_ID 2023.01.04 박장순 추가 */
     , PRD.PRD_CHRC_CD AS GOODS_CHRC_CD /*상품 특성 코드 100일반, 200알뜰, 300리퍼*/
FROM   TB_PD_GP_PRD GPD             /* 그룹상품테이블    2023.01.03 박장순 추가 */
   , TB_PD_GP_PRD_MAPG GPM        /* 그룹상품매핑      2023.01.03 박장순 추가 */
   , TB_PD_PRD PRD
   , TB_PD_UNT UNT
   , TB_PD_SUPP SUPP
   , TB_CM_CODE_DTL CD1
WHERE  GPD.USE_YN = 'Y'         /* 그룹상품사용여부    2023.01.03 박장순 추가 */
  AND    GPD.GP_PRD_APV_STS_CD = '310' /*그룹상품승인상태코드 MD팀장승인*/
  AND    GPD.GP_PRD_ID = GPM.GP_PRD_ID     /* 그룹상품,그룹상품매핑 조인 2023.01.03 박장순 추가*/
  AND    GPM.DLG_YN = 'Y'         /*그룹상품 대표상품여부 2023.01.03 박장순 추가*/
  AND    GPM.PRD_ID = PRD.PRD_ID  /*그룹상품 대표상품번호 2023.01.3 박장순 추가*/
  AND    PRD.USE_YN = 'Y' /*상품사용여부*/
  AND    PRD.PRD_APV_STS_CD = '310' /*상품승인상태코드 MD팀장승인*/
  AND    PRD.PRD_SL_STS_CD > '100' /*상품판매상태코드*/
  AND    PRD.ADD_COMP_PRD_YN = 'N' /*추가구성상품여부*/
  AND    PRD.PRD_PATTN_CD IN ('100','300') /*100 일반, 200 사은품, 300 특수상품*/
  AND    PRD.PRD_ID = UNT.PRD_ID  /*대표단품번호*/
  AND    UNT.USE_YN = 'Y'
  AND    UNT.DLG_UNT_YN = 'Y'
  AND    PRD.SUPP_ID = SUPP.SUPP_ID (+)
  AND    CD1.CD (+)= 'ORD_DLVF_CD'
  AND    PRD.ORD_DLVF_CD = CD1.CD_VAL (+)
  --검색조건 (상품에 변경사항(신규등록 또는 수정)이 발생한경우)
  AND (
    (    GPD.MDF_DTM >= V_BATCH_STRD_DTIME
        AND    GPD.MDF_DTM < V_SYS_DTIME
        )
        OR
    (    GPM.MDF_DTM >= V_BATCH_STRD_DTIME
        AND    GPM.MDF_DTM < V_SYS_DTIME
        )
        OR
    (    PRD.MDF_DTM >= V_BATCH_STRD_DTIME
        AND    PRD.MDF_DTM < V_SYS_DTIME
        )
        OR
    (
        UNT.MDF_DTM >= V_BATCH_STRD_DTIME   --대표단품에 변경사항이 생긴경우
            AND    UNT.MDF_DTM < V_SYS_DTIME
        )
        OR
    (
        SUPP.TRAD_MRKT_MDF_DTM >= V_BATCH_STRD_DTIME   --협력사 정보(VIEW)에 전통시장여부 변경사항이 생긴경우
            AND    SUPP.TRAD_MRKT_MDF_DTM < V_SYS_DTIME
        )
        OR
    (
        ( GPD.DP_BGN_DTM >= V_BATCH_STRD_DTIME AND GPD.DP_BGN_DTM < V_SYS_DTIME ) OR
        ( GPD.DP_END_DTM >= V_BATCH_STRD_DTIME AND GPD.DP_END_DTM < V_SYS_DTIME )
        )
    )
;

