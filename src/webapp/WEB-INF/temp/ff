CURSOR C_CPN_LIST IS
SELECT CPN.CPN_ID
     , CPN.CPN_NM
     , CPN.CPN_RTAMT_TYP_CD AS CPN_RTAMT_TP_CD
     , CPN.CPN_SELFCO_BRN_RTAMT + CPN.CPN_SUPP_BRN_RTAMT AS CPN_DC_RTAMT
     , CPN.PRT_BGN_DTM  AS CPN_STRT_DTIME
     , CPN.PRT_END_DTM  AS CPN_END_DTIME
     , CPP.PRD_ID AS GOODS_NO
FROM   TB_PD_CPN CPN
   , TB_PD_CPN_PRT_PRD CPP
   , TB_PD_PRD PRD
   , TB_PD_PRD_ONL_DTL PRDONL
WHERE  CPN.USE_YN = 'Y'
  AND    CPN.CPN_STS_CD = '110' /*진행*/
  AND    CPN.CPN_APV_STS_CD = '210' /*승인*/
  AND    CPN.CPN_PATTN_CD = '100' /*가격할인*/
  AND    CPN.CPN_PRT_PATTN_CD ='110' /*개별발행*/
  AND    CPN.CPN_PRT_TYP_CD = '110' /*수동발행*/
  AND    CPN.DNLOAD_CPN_YN = 'Y'   /*다운로드_쿠폰_여부*/
  AND    SYSDATE BETWEEN CPN.PRT_BGN_DTM AND CPN.PRT_END_DTM /*발행기간*/
  AND    CPN.TRT_PRD_PRT_LMT_YN = 'Y' /*대상_상품_발행_제한_여부*/
  AND    CPP.USE_YN = 'Y'
