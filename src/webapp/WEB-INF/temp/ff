    --프로모션 가격할인 적용
BEGIN
        --중단, 긴급중단 프로모션의 업데이트
UPDATE TF_GOODS_RETRV
SET    PR_ID = NULL
  , PR_NM = NULL
  , PR_STRT_DTIME = NULL
  , PR_END_DTIME = NULL
  , PR_RTAMT_TP_CD = NULL
  , PR_DC_RTAMT = 0
  , PMT_PRC_DSN_YN = 'N'
  , MOD_DTIME = V_SYS_DTIME
  , EP_MOD_DTIME = V_SYS_DTIME
WHERE  PR_ID IN (
    SELECT PMT_ID
    FROM   TB_PD_PMT PMT
    WHERE  PMT.USE_YN = 'Y'
      AND    PMT.PMT_STS_CD IN ('120', '130') /*중단, 긴급중단*/
      AND    PMT.PMT_APV_STS_CD = '210' /*승인*/
      AND    PMT.PMT_PATTN_CD = '100' /*가격할인_상품*/
      AND    PMT.MDF_DTM >= V_BATCH_STRD_DTIME
      AND    PMT.MDF_DTM < V_SYS_DTIME
      AND    PMT.TRT_PRD_LMT_YN = 'Y'                 --상품 대상 프로모션중에
      --AND    V_SYS_DTIME BETWEEN PMT.PMT_BGN_DTM AND PMT.PMT_END_DTM  --진행중 프로모션
      AND    V_SYS_DTIME BETWEEN TO_DATE(TO_CHAR(PMT.PMT_BGN_DTM,'YYYY/MM/DD') || PMT.APPLY_BGN_HH_MI || '00','YYYY/MM/DD HH24:MI:SS') AND TO_DATE(TO_CHAR(PMT.PMT_END_DTM,'YYYY/MM/DD') || PMT.APPLY_END_HH_MI || '00','YYYY/MM/DD HH24:MI:SS') --진행중 프로모션
)
;
V_U_CNT := SQL%ROWCOUNT;
COMMIT WORK;    --가격할인 프로모션 중단
V_EXE_RSLT := V_EXE_RSLT || ' 가격할인중단:'||V_U_CNT;

OPEN C_PMT_LIST;
FETCH C_PMT_LIST
    BULK COLLECT INTO T_PMT;
CLOSE C_PMT_LIST;
V_U_CNT := 0;
        IF T_PMT.COUNT > 0 THEN
            FOR idx IN T_PMT.FIRST .. T_PMT.LAST
                LOOP
UPDATE TF_GOODS_RETRV GR
SET    PR_ID = T_PMT(idx).PR_ID
  , PR_NM = T_PMT(idx).PR_NM
  , PR_STRT_DTIME = T_PMT(idx).PR_STRT_DTIME
  , PR_END_DTIME = T_PMT(idx).PR_END_DTIME
  , PR_RTAMT_TP_CD = T_PMT(idx).PR_RTAMT_TP_CD
  , PR_DC_RTAMT = T_PMT(idx).PR_DC_RTAMT
  , PR_MAX_AMT_LMT_YN = T_PMT(idx).PR_MAX_AMT_LMT_YN
  , PR_APLY_MAX_AMT = T_PMT(idx).PR_APLY_MAX_AMT
  , MOD_DTIME = V_SYS_DTIME
  , EP_MOD_DTIME = V_SYS_DTIME
WHERE  GOODS_NO = T_PMT(idx).GOODS_NO
  AND    SALE_PRC > 0
  AND    (T_PMT(idx).PR_RTAMT_TP_CD = '100'
    OR (
              T_PMT(idx).PR_RTAMT_TP_CD = '200' AND T_PMT(idx).PR_DC_RTAMT <= SALE_PRC    /*프로모션은 쿠폰을 생각하지 않고 처리*/
              ))
  AND    ((PR_ID IS NULL OR PR_END_DTIME < V_SYS_DTIME)
    OR DECODE(PR_RTAMT_TP_CD, '100', SALE_PRC * PR_DC_RTAMT / 100, SALE_PRC + PR_DC_RTAMT)
              < DECODE(T_PMT(idx).PR_RTAMT_TP_CD, '100', SALE_PRC * T_PMT(idx).PR_DC_RTAMT / 100, SALE_PRC + T_PMT(idx).PR_DC_RTAMT)
    )
;
V_U_CNT := V_U_CNT + SQL%ROWCOUNT;
END LOOP;
COMMIT WORK;    --가격할인 프로모션
V_EXE_RSLT := V_EXE_RSLT || ' 가격할인변경:'||V_U_CNT;
END IF;
END;

