                                AND    PCLS.PRD_LCLS_ID = PRD.PRD_LCLS_ID
                                AND    PCLS.PRD_MCLS_ID = PRD.PRD_MCLS_ID)
                                OR     (PCLS.PRD_CLS_LV = 3
                                AND    PCLS.PRD_LCLS_ID = PRD.PRD_LCLS_ID
                                AND    PCLS.PRD_MCLS_ID = PRD.PRD_MCLS_ID
                                AND    PCLS.PRD_SCLS_ID = PRD.PRD_SCLS_ID)
                                OR     (PCLS.PRD_CLS_LV = 4
                                AND    PCLS.PRD_LCLS_ID = PRD.PRD_LCLS_ID
                                AND    PCLS.PRD_MCLS_ID = PRD.PRD_MCLS_ID
                                AND    PCLS.PRD_SCLS_ID = PRD.PRD_SCLS_ID
                                AND    PCLS.PRD_DCLS_ID = PRD.PRD_DCLS_ID)
                            )
        )
              )
    )
  AND    (CPN.TRT_EXPT_SUPP_PRT_LMT_YN = 'N' /*대상_제외_협력사_발행_제한_여부*/
    OR     (CPN.TRT_EXPT_SUPP_PRT_LMT_YN = 'Y'
        AND    NOT EXISTS ( SELECT 1
                            FROM   TB_PD_CPN_PRT_EXPT_SUPP CPES
                            WHERE  CPES.CPN_ID = CPN.CPN_ID
                              AND    CPES.SUPP_ID = PRD.SUPP_ID
                              AND    CPES.USE_YN = 'Y' )))
  AND    (CPN.TRT_EXPT_PRD_CLS_PRT_LMT_YN = 'N' /*대상_제외_상품_분류_발행_제한_여부*/
    OR     (CPN.TRT_EXPT_PRD_CLS_PRT_LMT_YN = 'Y'
        AND    NOT EXISTS ( SELECT 1
                            FROM   TB_PD_CPN_PRT_EXPT_PRD_CLS PCLS
                            WHERE  PCLS.CPN_ID = CPN.CPN_ID
                              AND    PCLS.USE_YN = 'Y'
                              AND    (
                                (PCLS.PRD_CLS_LV = 1 AND PCLS.PRD_LCLS_ID = PRD.PRD_LCLS_ID)
                                    OR     (PCLS.PRD_CLS_LV = 2
                                    AND    PCLS.PRD_LCLS_ID = PRD.PRD_LCLS_ID
                                    AND    PCLS.PRD_MCLS_ID = PRD.PRD_MCLS_ID)
                                    OR     (PCLS.PRD_CLS_LV = 3
                                    AND    PCLS.PRD_LCLS_ID = PRD.PRD_LCLS_ID
                                    AND    PCLS.PRD_MCLS_ID = PRD.PRD_MCLS_ID
                                    AND    PCLS.PRD_SCLS_ID = PRD.PRD_SCLS_ID)
                                    OR     (PCLS.PRD_CLS_LV = 4
                                    AND    PCLS.PRD_LCLS_ID = PRD.PRD_LCLS_ID
                                    AND    PCLS.PRD_MCLS_ID = PRD.PRD_MCLS_ID
                                    AND    PCLS.PRD_SCLS_ID = PRD.PRD_SCLS_ID
                                    AND    PCLS.PRD_DCLS_ID = PRD.PRD_DCLS_ID)
                                )
        )
              )
    )
  AND    (CPN.TRT_EXPT_PRD_PRT_LMT_YN = 'N' /*대상_제외_상품_발행_제한_여부*/
    OR     (CPN.TRT_EXPT_PRD_PRT_LMT_YN = 'Y'
        AND    NOT EXISTS ( SELECT 1
                            FROM   TB_PD_CPN_PRT_EXPT_PRD CPEP
                            WHERE  CPEP.CPN_ID = CPN.CPN_ID
                              AND    CPEP.PRD_ID = PRD.PRD_ID
                              AND    CPEP.USE_YN = 'Y' )))
  AND    NOT EXISTS ( SELECT 1
                      FROM   TB_PD_PRD_SL_IMPSS_CHNL PSIC
                      WHERE  PSIC.PRD_ID = PRD.PRD_ID
                        AND    PSIC.MDA_CD IN ('110') /*110 인터넷*/
                        AND    PSIC.USE_YN = 'Y'
)
  AND    CPN.CPN_ONL_PATTN_CD = '100'
;

