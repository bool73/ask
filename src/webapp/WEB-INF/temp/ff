    OR( NVL(CPN.CPN_PRD_TYP_CD ,'100') = '200' AND PRD.ONL_PRD_YN='Y')
    OR( NVL(CPN.CPN_PRD_TYP_CD ,'100') = '300' AND PRD.ONL_PRD_YN='N')
