END;
    /************************************************************
     * BATCH LOG
     ************************************************************/
    PROCEDURE P_UPDATE_BATCH_EXE_HIS IS
        PRAGMA AUTONOMOUS_TRANSACTION;
BEGIN
UPDATE TF_BATCH_EXE_HIS
SET    EXE_END_DTIME = SYSDATE
  , EXE_RSLT_CD = V_EXE_RSLT_CD
  , EXE_RSLT = V_EXE_RSLT
  , MODMN_ID = V_USERID
  , MOD_DTIME = SYSDATE
WHERE  BATCH_NO = 1
  AND    EXE_STRT_DTIME = V_SYS_DTIME
;
COMMIT WORK;
END;
/****************************************************************************************************
* START PROCEDURE
*****************************************************************************************************/
BEGIN
    V_SYS_DTIME := SYSDATE;
    --실행중인 배치가 있는 경우 SKIP
BEGIN
SELECT COUNT(1)
INTO   V_CNT
FROM   TF_BATCH_EXE_HIS
WHERE  EXE_STRT_DTIME > SYSDATE - 1
  AND    BATCH_NO = 1
  AND    EXE_RSLT_CD = '0'
;
IF V_CNT > 0 THEN
            --BATCH LOG 등록
            P_INSERT_BATCH_EXE_HIS();
            V_EXE_RSLT_CD := 9;
            V_EXE_RSLT := '실패 실행중배치 존재';
            P_UPDATE_BATCH_EXE_HIS();
            RETURN;
END IF;
EXCEPTION WHEN OTHERS THEN
        --BATCH LOG 등록
        P_INSERT_BATCH_EXE_HIS();
        V_EXE_RSLT_CD := 9;
        V_EXE_RSLT := '실패 실행중배치 체크 오류' || ' ' || SQLERRM;
        P_UPDATE_BATCH_EXE_HIS();
        RETURN;
END;
