CURSOR C_PRICE_LIST IS
SELECT UPC.PRD_ID AS GOODS_NO /*상품번호*/
     , UPC.UNT_ID AS ITEM_NO    /*단품번호*/
     , TRUNC(UPC.UPRC) AS SALE_PRC /*판매가*/
     , UPC.PRC_BGN_DTM AS SALE_PRC_STRT_DTIME /*가격시작일자*/
     , UPC.PRC_END_DTM AS SALE_PRC_END_DTIME /*가격종료일자*/
FROM   TB_PD_UNT_PRC_CHG UPC , TB_PD_UNT UNT
WHERE  UPC.PRD_ID = UNT.PRD_ID
  AND    UPC.UNT_ID = UNT.UNT_ID
  AND    UPC.USE_YN = 'Y'
  AND    UPC.PRC_APV_STS_CD = '310'
  --AND    UNT.UNT_SL_STS_CD IN ('110' , '120')
  AND    UNT.DLG_UNT_YN = 'Y' /*상품별로 가격을 1개만 보여주기 위해*/
  AND    UNT.USE_YN = 'Y'
  --검색조건 (가격에 변경사항(신규등록 또는 수정)이 발생한경우)
  AND    (
    (UPC.PRC_BGN_DTM >= V_BATCH_STRD_DTIME AND UPC.PRC_BGN_DTM < V_SYS_DTIME)
        OR
    (
        UPC.MDF_DTM >= V_BATCH_STRD_DTIME
            AND UPC.MDF_DTM < V_SYS_DTIME
            AND UPC.PRC_END_DTM > V_BATCH_STRD_DTIME
            AND UPC.PRC_BGN_DTM <= V_BATCH_STRD_DTIME
        )
        OR
    (
        UNT.MDF_DTM >= V_BATCH_STRD_DTIME
            AND UNT.MDF_DTM < V_SYS_DTIME
        )
    )
  AND    SYSDATE BETWEEN UPC.PRC_BGN_DTM AND UPC.PRC_END_DTM
;
TYPE TYPE_PRICE_LIST IS TABLE OF C_PRICE_LIST%ROWTYPE INDEX BY BINARY_INTEGER;
    T_PRICE TYPE_PRICE_LIST;

    --상품단품가격수량 조회 커서
CURSOR C_UNT_PRICE_GAP_CNT_LIST IS
SELECT UNT.PRD_ID AS GOODS_NO
FROM   TB_PD_UNT_PRC_CHG UPC , TB_PD_UNT UNT
WHERE  UPC.PRD_ID = UNT.PRD_ID
  AND    UPC.UNT_ID = UNT.UNT_ID
  AND    UPC.USE_YN = 'Y'
  AND    UPC.PRC_APV_STS_CD = '310'
  AND    UNT.UNT_SL_STS_CD = '110'
  AND    UNT.USE_YN = 'Y'
  AND    SYSDATE BETWEEN UPC.PRC_BGN_DTM AND UPC.PRC_END_DTM
  --검색조건 (가격에 변경사항(신규등록 또는 수정)이 발생한경우)
  AND    (
    (UPC.PRC_BGN_DTM >= V_BATCH_STRD_DTIME AND UPC.PRC_BGN_DTM < V_SYS_DTIME)
        OR
    (
        UPC.MDF_DTM >= V_BATCH_STRD_DTIME
            AND UPC.MDF_DTM < V_SYS_DTIME
            AND UPC.PRC_END_DTM > V_BATCH_STRD_DTIME
            AND UPC.PRC_BGN_DTM <= V_BATCH_STRD_DTIME
        )
        OR
    (
        UNT.MDF_DTM >= V_BATCH_STRD_DTIME
            AND UNT.MDF_DTM < V_SYS_DTIME
        )
    )
GROUP BY UNT.PRD_ID
;
TYPE TYPE_UNT_PRICE_GAP_CNT_LIST IS TABLE OF C_UNT_PRICE_GAP_CNT_LIST%ROWTYPE INDEX BY BINARY_INTEGER;
    T_UNT_PRICE_GAP_CNT TYPE_UNT_PRICE_GAP_CNT_LIST;

    /* 프로모션 커서 */
CURSOR C_PMT_LIST IS
SELECT PMT.PMT_ID AS PR_ID
     , PMT.PMT_NM AS PR_NM
     , TO_DATE(TO_CHAR(PMT.PMT_BGN_DTM,'YYYY/MM/DD') || PMT.APPLY_BGN_HH_MI || '00','YYYY/MM/DD HH24:MI:SS') AS PR_STRT_DTIME
     , TO_DATE(TO_CHAR(PMT.PMT_END_DTM,'YYYY/MM/DD') || PMT.APPLY_END_HH_MI || '00','YYYY/MM/DD HH24:MI:SS') AS PR_END_DTIME
     , PMT.PMT_RTAMT_TYP_CD AS PR_RTAMT_TP_CD /*100 정률 200 정액*/
     , PMT.PMT_SELFCO_BRN_RTAMT + PMT.PMT_SUPP_BRN_RTAMT AS PR_DC_RTAMT
     , PPRD.PRD_ID AS GOODS_NO
     , PMT.MAX_AMT_LMT_YN AS PR_MAX_AMT_LMT_YN
     , PMT.PMT_APPLY_MAX_AMT AS PR_APLY_MAX_AMT
FROM   TB_PD_PMT PMT, TB_PD_PMT_PRD PPRD, TB_PD_PRD PRD
WHERE  PMT.USE_YN = 'Y'
  AND    PMT.PMT_STS_CD = '110' /*진행*/
  AND    PMT.PMT_APV_STS_CD = '210' /*승인*/
  AND    PMT.PMT_PATTN_CD = '100' /*가격할인_상품*/
  AND    PMT.PMT_APPLY_CST_LMT_YN = 'N' /*프로모션_적용_고객_제한_여부*/
  AND    PMT.PMT_PRTC_TMS_LMT_YN = 'N' /*프로모션_참여_횟수_제한_여부*/
  AND    PMT.PMT_CST_PRTC_TMS_LMT_YN = 'N' /*프로모션_고객_참여_횟수_제한_여부*/
  AND    PMT.TRT_AR_LMT_YN = 'N' /*대상_지역_제한_여부*/
  AND    PMT.TRT_CST_GD_LMT_YN = 'N' /*대상_고객_등급_제한_여부*/
  AND    PMT.TRT_CST_LMT_YN = 'N' /*대상_고객_제한_여부*/
  AND    V_SYS_DTIME BETWEEN TO_DATE(TO_CHAR(PMT.PMT_BGN_DTM,'YYYY/MM/DD') || PMT.APPLY_BGN_HH_MI || '00','YYYY/MM/DD HH24:MI:SS') AND TO_DATE(TO_CHAR(PMT.PMT_END_DTM,'YYYY/MM/DD') || PMT.APPLY_END_HH_MI || '00','YYYY/MM/DD HH24:MI:SS') /*프로모션 */
  AND    PMT.TRT_PRD_LMT_YN = 'Y'  /*대상_상품_제한_여부*/
  AND    PMT.PMT_ID = PPRD.PMT_ID
  AND    PMT.PMT_BGN_DTM IS NOT NULL
  AND    PMT.PMT_END_DTM IS NOT NULL
  AND    PPRD.USE_YN = 'Y'
    /* 프로모션상품구분코드 100:전체, 200:온라인, 300:방송 */
  AND ( NVL(PMT.PMT_PRD_TYP_CD ,'100') = '100'
    OR( NVL(PMT.PMT_PRD_TYP_CD ,'100') = '200' AND PRD.ONL_PRD_YN='Y')
    OR( NVL(PMT.PMT_PRD_TYP_CD ,'100') = '300' AND PRD.ONL_PRD_YN='N')
    )
  AND    (PMT.TRT_CHNL_LMT_YN = 'N' /*대상_채널_제한_여부*/
    OR      (PMT.TRT_CHNL_LMT_YN = 'Y'
        AND NOT EXISTS (SELECT 1
                        FROM   TB_PD_PMT_IMPSS_CHNL PIC
                        WHERE  PIC.PMT_ID = PMT.PMT_ID
                          AND    PIC.MDA_CD  = '110' --인터넷
                          AND    PIC.USE_YN = 'Y')))
  AND    (PMT.TRT_SUPP_LMT_YN = 'N' /*대상_협력사_제한_여부*/
    OR     (PMT.TRT_SUPP_LMT_YN = 'Y'
        AND    EXISTS ( SELECT 1
                        FROM   TB_PD_PMT_SUPP SUPP
                        WHERE  SUPP.USE_YN = 'Y'
                          AND    SUPP.PMT_ID = PMT.PMT_ID
                          AND    SUPP.SUPP_ID = PRD.SUPP_ID)))
  AND    (PMT.TRT_PRD_CLS_LMT_YN = 'N' /*대상_상품_분류_제한_여부*/
    OR     (PMT.TRT_PRD_CLS_LMT_YN = 'Y'
        AND    EXISTS ( SELECT 1
                        FROM   TB_PD_PMT_PRD_CLS PCLS
                        WHERE  PCLS.USE_YN = 'Y'
                          AND    PCLS.PMT_ID = PMT.PMT_ID
                          AND    (
                            (PCLS.PRD_CLS_LV = 1 AND PCLS.PRD_LCLS_ID = PRD.PRD_LCLS_ID)
                                OR     (PCLS.PRD_CLS_LV = 2
                                AND    PCLS.PRD_LCLS_ID = PRD.PRD_LCLS_ID
                                AND    PCLS.PRD_MCLS_ID = PRD.PRD_MCLS_ID)
                                OR     (PCLS.PRD_CLS_LV = 3
                                AND    PCLS.PRD_LCLS_ID = PRD.PRD_LCLS_ID
                                AND    PCLS.PRD_MCLS_ID = PRD.PRD_MCLS_ID
                                AND    PCLS.PRD_SCLS_ID = PRD.PRD_SCLS_ID)
                                OR     (PCLS.PRD_CLS_LV = 4
                                AND    PCLS.PRD_LCLS_ID = PRD.PRD_LCLS_ID
                                AND    PCLS.PRD_MCLS_ID = PRD.PRD_MCLS_ID
                                AND    PCLS.PRD_SCLS_ID = PRD.PRD_SCLS_ID
                                AND    PCLS.PRD_DCLS_ID = PRD.PRD_DCLS_ID)
                            )
        )
              )
    )
  AND    (PMT.TRT_EXPT_PRD_LMT_YN = 'N' /*대상_제외_상품_제한_여부*/
    OR     (PMT.TRT_EXPT_PRD_LMT_YN = 'Y'
        AND NOT EXISTS (SELECT 1 /*프로모션_제외_상품*/
                        FROM   TB_PD_PMT_EXPT_PRD PEP
                        WHERE  PEP.PRD_ID = PRD.PRD_ID
                          AND    PEP.PMT_ID = PMT.PMT_ID
                          AND    PEP.USE_YN = 'Y' )))
  AND    (PMT.TRT_INFLX_PT_LMT_YN = 'N' /*대상_유입_경로_제한_여부*/
    OR     (PMT.TRT_INFLX_PT_LMT_YN = 'Y'
        AND NOT EXISTS (SELECT 1
                        FROM   TB_PD_PMT_IMPSS_ORD_INFLX_PT PIOIP
                        WHERE  PIOIP.PMT_ID = PMT.PMT_ID
                          AND    PIOIP.USE_YN = 'Y'
                          AND    PIOIP.ORD_INFLX_PT_CD IN ('120' , '130') /*120 인터넷, 130 M-Commerce*/)))
  AND    PPRD.PRD_ID = PRD.PRD_ID
  AND    PRD.USE_YN = 'Y'
  AND    PRD.PRD_APV_STS_CD = '310'
  AND    PRD.PRD_SL_STS_CD IN ('110' , '120')
  AND    PRD.PRD_PATTN_CD IN ('100', '300')   /*100 일반, 200 사은품, 300 특수상품*/
  AND    PRD.ADD_COMP_PRD_YN = 'N' /*추가구성상품여부*/
  AND    PMT.PRD_MIN_ORD_AMT_LMT_YN !='Y'
          AND    PMT.PRD_MIN_ORD_QTY_LMT_YN !='Y'
          AND    NOT EXISTS ( SELECT 1
                              FROM   TB_PD_PRD_SL_IMPSS_CHNL PSIC
                              WHERE  PSIC.PRD_ID = PRD.PRD_ID
                                AND    PSIC.MDA_CD IN ('110') /*110 인터넷*/
                                AND    PSIC.USE_YN = 'Y'
            )
;
TYPE TYPE_PMT_LIST IS TABLE OF C_PMT_LIST%ROWTYPE INDEX BY BINARY_INTEGER;
    T_PMT TYPE_PMT_LIST;
