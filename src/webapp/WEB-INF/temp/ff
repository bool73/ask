    --쿠폰다운로드 적용
BEGIN
        --중단 쿠폰의 업데이트
UPDATE TF_GOODS_RETRV
SET    CPN_ID = NULL
  , CPN_NM = NULL
  , CPN_STRT_DTIME = NULL
  , CPN_END_DTIME = NULL
  , CPN_RTAMT_TP_CD = NULL
  , CPN_DC_RTAMT = 0
  , MOD_DTIME = V_SYS_DTIME
  , EP_MOD_DTIME = V_SYS_DTIME
WHERE  CPN_ID IN (
    SELECT CPN_ID
    FROM   TB_PD_CPN CPN
    WHERE  CPN.USE_YN = 'Y'
      AND    CPN.CPN_STS_CD = '120' /*중단*/
      AND    CPN.CPN_APV_STS_CD = '210' /*승인*/
      AND    CPN.CPN_PATTN_CD = '100' /*가격할인_상품*/
      AND    CPN.MDF_DTM >= V_BATCH_STRD_DTIME
      AND    CPN.MDF_DTM < V_SYS_DTIME
      AND    CPN.TRT_PRD_PRT_LMT_YN = 'Y'                 --상품 대상 쿠폰중에
      AND    V_SYS_DTIME BETWEEN CPN.PRT_BGN_DTM AND CPN.PRT_END_DTM /*발행기간*/
)
;
V_U_CNT := SQL%ROWCOUNT;
COMMIT WORK;    --쿠폰다운로드 중단
V_EXE_RSLT := V_EXE_RSLT || ' 쿠폰중단:'||V_U_CNT;
OPEN C_CPN_LIST;
FETCH C_CPN_LIST
    BULK COLLECT INTO T_CPN;
CLOSE C_CPN_LIST;
V_U_CNT := 0;
        IF T_CPN.COUNT > 0 THEN
            FOR idx IN T_CPN.FIRST .. T_CPN.LAST
                LOOP
UPDATE TF_GOODS_RETRV GR
SET    CPN_ID = T_CPN(idx).CPN_ID
  , CPN_NM = T_CPN(idx).CPN_NM
  , CPN_STRT_DTIME = T_CPN(idx).CPN_STRT_DTIME
  , CPN_END_DTIME = T_CPN(idx).CPN_END_DTIME
  , CPN_RTAMT_TP_CD = T_CPN(idx).CPN_RTAMT_TP_CD
  , CPN_DC_RTAMT = T_CPN(idx).CPN_DC_RTAMT
  , MOD_DTIME = V_SYS_DTIME
  , EP_MOD_DTIME = V_SYS_DTIME
WHERE  GOODS_NO = T_CPN(idx).GOODS_NO
  AND    SALE_PRC > 0
  AND    (T_CPN(idx).CPN_RTAMT_TP_CD = '100'
    OR (
              T_CPN(idx).CPN_RTAMT_TP_CD = '200' AND T_CPN(idx).CPN_DC_RTAMT +
                                                     CASE WHEN PR_ID IS NOT NULL
                                                         AND V_SYS_DTIME BETWEEN PR_STRT_DTIME AND PR_END_DTIME
                                                              THEN
                                                              CASE
                                                                  WHEN PR_MAX_AMT_LMT_YN = 'Y'
                                                                      THEN DECODE( SIGN(PR_APLY_MAX_AMT - DECODE(PR_RTAMT_TP_CD, '100', ROUND(SALE_PRC * PR_DC_RTAMT / 100), PR_DC_RTAMT)), -1, PR_APLY_MAX_AMT, DECODE(PR_RTAMT_TP_CD, '100', ROUND(SALE_PRC * PR_DC_RTAMT / 100), PR_DC_RTAMT) )
                                                                  ELSE DECODE(PR_RTAMT_TP_CD, '100', ROUND(SALE_PRC * PR_DC_RTAMT / 100), PR_DC_RTAMT)
                                                                  END
                                                          ELSE 0 END <= SALE_PRC
              ))
  AND   ((CPN_ID IS NULL OR CPN_END_DTIME < V_SYS_DTIME)
    OR DECODE(CPN_RTAMT_TP_CD, '100', SALE_PRC * CPN_DC_RTAMT / 100, SALE_PRC + CPN_DC_RTAMT)
             < DECODE(T_CPN(idx).CPN_RTAMT_TP_CD, '100', SALE_PRC * T_CPN(idx).CPN_DC_RTAMT / 100, SALE_PRC + T_CPN(idx).CPN_DC_RTAMT)
    )
;
V_U_CNT := V_U_CNT + SQL%ROWCOUNT;
END LOOP;
COMMIT WORK;    --쿠폰다운로드
V_EXE_RSLT := V_EXE_RSLT || ' 쿠폰변경:'||V_U_CNT;
END IF;
END;

