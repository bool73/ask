BEGIN
SELECT /*+INDEX_DESC(BEH PK_BATCH_EXE_HIS)*/
    EXE_STRT_DTIME - 1/48        /*30분 전 데이터까지 포함 mview 로 인한 로스때문에*/
INTO   V_BATCH_STRD_DTIME
FROM   TF_BATCH_EXE_HIS BEH
WHERE  SYSDATE > EXE_STRT_DTIME
  AND    BATCH_NO = 1
  AND    EXE_RSLT_CD = 1
  AND    ROWNUM = 1
;
EXCEPTION WHEN NO_DATA_FOUND THEN
            --V_BATCH_STRD_DTIME := SYSDATE - 1/12;                     -- 1시간 이전
            V_BATCH_STRD_DTIME := TO_DATE('20150101', 'YYYYMMDD');
END;
ELSE
        V_BATCH_STRD_DTIME := TO_DATE(in_strd_dtime, 'YYYYMMDDHH24MISS');
END IF;
    --BATCH LOG 등록
    P_INSERT_BATCH_EXE_HIS();
OPEN C_GOODS_LIST;
FETCH C_GOODS_LIST
    BULK COLLECT INTO T_GOODS;
CLOSE C_GOODS_LIST;
IF T_GOODS.COUNT > 0 THEN
        FOR idx IN T_GOODS.FIRST .. T_GOODS.LAST
            LOOP
                --초기화
                R_GOODS := NULL;
                R_GOODS_EXT := NULL;
                R_GOODS.GOODS_NO := T_GOODS(IDX).GOODS_NO;
                R_GOODS_EXT.GOODS_NO := T_GOODS(IDX).GOODS_NO;
                R_GOODS.GOODS_NM := T_GOODS(idx).GOODS_NM;
                R_GOODS.ONL_GOODS_NM := T_GOODS(idx).ONL_GOODS_NM;
                R_GOODS.ITEM_NO := CASE WHEN T_GOODS(idx).GRP_GOODS_YN = 'N' THEN T_GOODS(idx).ITEM_NO ELSE NULL END; /*그룹상품 단품번호 RESET 2023.01.04 박장순 추가 */
                R_GOODS.SALE_STAT_CD := T_GOODS(idx).SALE_STAT_CD;
                R_GOODS.INTF_INTT_YN := T_GOODS(idx).INTF_INTT_YN;
                R_GOODS.INTF_INTT_MMS := T_GOODS(idx).INTF_INTT_MMS;
                R_GOODS.DEAL_GOODS_YN := T_GOODS(idx).DEAL_GOODS_YN;
                R_GOODS.TV_GOODS_YN := T_GOODS(idx).TV_GOODS_YN;
                R_GOODS.EC_GOODS_YN := T_GOODS(idx).EC_GOODS_YN;
                --             , PRD.ORD_DLVF_YN          /*주문배송비여부 N=무료*/
--             , NVL(TO_NUMBER(CD1.CD_VAL_NM), 0) AS ORD_DLVF_CD_VAL  /*주문배송비코드값-배송비*/
--             , PRD.F_DLV_STD_CD                 /*무료배송기준코드*/
--             , PRD.F_DLV_STD_UNIT               /*무료배송기준단위*/
--             , PRD.DLVF_IMPOSE_STD_CD           /*배송비부과기준코드*/
--             , PRD.DLVF_IMPOSE_STD_UNIT         /*배송비부과기준단위*/
                R_GOODS.SUPP_ID := T_GOODS(idx).SUPP_ID;
                R_GOODS.SUPP_NM := T_GOODS(idx).SUPP_NM;
                R_GOODS.BRND_ID := T_GOODS(idx).BRND_ID;
                R_GOODS.BRND_NM := T_GOODS(idx).BRND_NM;
                --상품분류, 전시카테고리 정보
                R_GOODS.GOODS_CLS_ID := T_GOODS(IDX).GOODS_CLS_ID;
                R_GOODS_EXT.GOODS_LCLS_ID := T_GOODS(IDX).GOODS_LCLS_ID;
                R_GOODS_EXT.GOODS_MCLS_ID := T_GOODS(IDX).GOODS_MCLS_ID;
                R_GOODS_EXT.GOODS_SCLS_ID := T_GOODS(idx).GOODS_SCLS_ID;
                R_GOODS_EXT.GOODS_DCLS_ID := T_GOODS(IDX).GOODS_CLS_ID;     /* 2022.12.29 상품세분류ID 추가 박장순 */
--            R_GOODS.IMG_URL := T_GOODS(idx).IMG_URL;
                R_GOODS.RETRV_WD := T_GOODS(idx).RETRV_WD;
                --            R_GOODS.GOODS_WEB_MNL_CONT := T_GOODS(idx).GOODS_WEB_MNL_CONT;
--            R_GOODS.GOODS_MNL_CONT := T_GOODS(idx).GOODS_MNL_CONT;
                R_GOODS.GOODS_REG_DTIME := T_GOODS(idx).GOODS_REG_DTIME;
                R_GOODS.ADULT_GOODS_YN := 'N';
                R_GOODS.DLV_MTD_CD := T_GOODS(idx).DLV_MTD_CD;
                R_GOODS.ARS_DC_SELFCO_BD_AMT := 0;
                R_GOODS.ARS_DC_SUPP_BD_AMT := 0;
                --16.01.14 추가 온라인 상품정보 테이블 분리로 인한 데이터 추가처리
                R_GOODS.DEAL_APLY_STRT_DTIME := T_GOODS(idx).DEAL_APLY_STRT_DTIME;
                R_GOODS.DEAL_APLY_END_DTIME := T_GOODS(idx).DEAL_APLY_END_DTIME;
                R_GOODS.MAX_ORD_PSB_QTY := T_GOODS(idx).MAX_ORD_PSB_QTY;
                R_GOODS.INSD_RETRV_EXCL_YN := T_GOODS(idx).INSD_RETRV_EXCL_YN;
                R_GOODS.ONL_PRD_TYP_CD := T_GOODS(idx).ONL_PRD_TYP_CD;
                --16.02.15 제품유형코드 추가
                R_GOODS.MANPRD_PATTN_CD := T_GOODS(idx).MANPRD_PATTN_CD;
                --16.03.04 배송특성코드 추가
                R_GOODS.DLV_CHRC_CD := T_GOODS(idx).DLV_CHRC_CD;
                --16.03.24 MD코드 추가
                R_GOODS.MD_ID := T_GOODS(idx).MD_ID;
                --16.12.27 임직원 상품여부 추가
                R_GOODS.EMP_GOODS_YN := T_GOODS(idx).EMP_GOODS_YN;
                --17.02.21 엔진페이지 제외 여부 추가
                R_GOODS.EP_EXCL_YN  := T_GOODS(idx).EP_EXCL_YN ;
                --17.03.10 모바일 할인 제외 여부 추가
                R_GOODS.MOBILE_DC_EXCL_YN  := T_GOODS(idx).MOBILE_DC_EXCL_YN ;
                --17.05.25 상품 형태 코드 추가
                R_GOODS.GOODS_SP_CD  := T_GOODS(idx).GOODS_SP_CD ;
                --17.07.19 모바일 적립금 제외 여부 추가
                R_GOODS.MOBILE_PNM_EXCL_YN  := T_GOODS(idx).MOBILE_PNM_EXCL_YN ;
                --18.01.04 배송비 착불 시 무료배송으로 처리
                R_GOODS.COD_YN  := T_GOODS(idx).COD_YN ;
                --온라인_상품_검색_명 추가
                R_GOODS.ONL_GOODS_RETRV_WD_1  := T_GOODS(idx).ONL_GOODS_RETRV_WD_1 ;
                R_GOODS.ONL_GOODS_RETRV_WD_2  := T_GOODS(idx).ONL_GOODS_RETRV_WD_2 ;
                R_GOODS.ONL_GOODS_RETRV_WD_3  := T_GOODS(idx).ONL_GOODS_RETRV_WD_3 ;
                R_GOODS.ONL_GOODS_RETRV_WD_4  := T_GOODS(idx).ONL_GOODS_RETRV_WD_4 ;
                R_GOODS.ONL_GOODS_RETRV_WD_5  := T_GOODS(idx).ONL_GOODS_RETRV_WD_5 ;
                R_GOODS.ONL_GOODS_RETRV_WD_6  := T_GOODS(idx).ONL_GOODS_RETRV_WD_6 ;
                --21.01.10 전통시장, 상품준비노출일시, 상품동영상등록여부 추가
                R_GOODS_EXT.TRDIT_MRKT_GOODS_YN   := T_GOODS(idx).TRDIT_MRKT_GOODS_YN ;
                R_GOODS_EXT.GOODS_PREP_SHOW_STRT_DTIME   := T_GOODS(idx).GOODS_PREP_SHOW_STRT_DTIME ;
                R_GOODS_EXT.GOODS_PREP_SHOW_END_DTIME   := T_GOODS(idx).GOODS_PREP_SHOW_END_DTIME ;
                --21.02.02 상품 구분 코드 추가 (MLC 상품구분 유형)
                R_GOODS.GOODS_SCT_CD  := T_GOODS(idx).GOODS_SCT_CD ;
                --21.04.12 상품운영형태코드 추가
                R_GOODS.GOODS_OPER_SP_CD  := T_GOODS(idx).GOODS_OPER_SP_CD ;
                --23.01.04 그룹상품여부 추가
                R_GOODS.GRP_GOODS_YN := T_GOODS(idx).GRP_GOODS_YN ;
                --25.03.24 상품특성 추가
                R_GOODS.GOODS_CHRC_CD := T_GOODS(idx).GOODS_CHRC_CD ;

                --변경된 상품정보로 MERGE 처리 하기
SELECT COUNT(1)
INTO   V_CNT
FROM   TF_GOODS_RETRV
WHERE  GOODS_NO = R_GOODS.GOODS_NO
;
IF V_CNT > 0 THEN
                    /**
                     * UPDATE TF_GOODS_RETRV 전 배송비 계산
                     */
                    V_TEMP_SALE_PRC := 0;
BEGIN
SELECT SALE_PRC INTO V_TEMP_SALE_PRC  FROM TF_GOODS_RETRV WHERE  GOODS_NO = R_GOODS.GOODS_NO;
EXCEPTION WHEN NO_DATA_FOUND THEN
                        NULL;
END;
                    -- 그룹상품 주문배송비 여부 로직 제외 2023.01.04 박장순 추가
                    IF T_GOODS(idx).GRP_GOODS_YN != 'Y' THEN
                        -- 주문배송비여부(ORD_DLVF_YN) 값이 Y 이고 주문배송비코드값-배송비 (ORD_DLVF_CD_VAL) 값이 0 보다 클 경우 아래 로직 비교 아니라면 무배 끝
                        IF T_GOODS(idx).ORD_DLVF_YN = 'Y' AND NVL(T_GOODS(idx).ORD_DLVF_CD_VAL, 0) > 0 THEN
                            --        무료배송기준코드 (F_DLV_STD_CD) 값이 200(수량)
                            IF T_GOODS(idx).F_DLV_STD_CD = '200' THEN
                                IF NVL(T_GOODS(idx).F_DLV_STD_UNIT, 0) <= 1 THEN
                                    R_GOODS.FREE_DLV_YN := 'Y';
                                    R_GOODS.DLV_COST := 0;
ELSE
                                    R_GOODS.FREE_DLV_YN := 'N';
                                    R_GOODS.DLV_COST := T_GOODS(idx).ORD_DLVF_CD_VAL;
END IF;
                                --        무료배송기준코드 (F_DLV_STD_CD) 값이 100(금액)
                            ELSIF T_GOODS(idx).F_DLV_STD_CD = '100' THEN
                                IF NVL(T_GOODS(idx).F_DLV_STD_UNIT, 0) <= 0 THEN
                                    R_GOODS.FREE_DLV_YN := 'Y';
                                    R_GOODS.DLV_COST := 0;
                                ELSIF NVL(T_GOODS(idx).F_DLV_STD_UNIT, 0) <=  V_TEMP_SALE_PRC THEN
                                    R_GOODS.FREE_DLV_YN := 'Y';
                                    R_GOODS.DLV_COST := 0;
ELSE
                                    R_GOODS.FREE_DLV_YN := 'N';
                                    R_GOODS.DLV_COST := T_GOODS(idx).ORD_DLVF_CD_VAL;
END IF;
                                -- 무료배송키준코드 (F_DLV_STD_CD) 값이 300 (무조건 유료)
                            ELSIF T_GOODS(idx).F_DLV_STD_CD = '300' THEN
                                R_GOODS.FREE_DLV_YN := 'N';
                                R_GOODS.DLV_COST := T_GOODS(IDX).ORD_DLVF_CD_VAL;
END IF;
                            --        주문배송비가 0 이거나 N 일 경우
ELSE
                            R_GOODS.FREE_DLV_YN := 'Y';
                            R_GOODS.DLV_COST := 0;
                            -- 무료배송키준코드 (F_DLV_STD_CD) 값이 400 (착불|착불배송비는 상품상세 설명으로 유도)
                            IF T_GOODS(IDX).F_DLV_STD_CD = '400' THEN
                                R_GOODS.COD_YN := 'Y';
ELSE
                                R_GOODS.COD_YN := 'N';
END IF;
END IF;
ELSE
                        R_GOODS.FREE_DLV_YN := 'N';
                        R_GOODS.DLV_COST := 0;
END IF;
                    /**
                     * UPDATE TF_GOODS_RETRV
                     */
UPDATE TF_GOODS_RETRV
SET
    GOODS_NM     = R_GOODS.GOODS_NM
  , SALE_STAT_CD = R_GOODS.SALE_STAT_CD
  , FREE_DLV_YN = R_GOODS.FREE_DLV_YN
  , DLV_COST = R_GOODS.DLV_COST
  , INTF_INTT_YN = R_GOODS.INTF_INTT_YN
  , INTF_INTT_MMS = R_GOODS.INTF_INTT_MMS
  , DEAL_GOODS_YN = R_GOODS.DEAL_GOODS_YN
  , TV_GOODS_YN = R_GOODS.TV_GOODS_YN
--                     , EC_GOODS_YN = R_GOODS.EC_GOODS_YN
--                     , L_DISP_CAT_NO = R_GOODS.L_DISP_CAT_NO
--                     , L_DISP_CAT_NM = R_GOODS.L_DISP_CAT_NM
--                     , M_DISP_CAT_NO = R_GOODS.M_DISP_CAT_NO
--                     , M_DISP_CAT_NM = R_GOODS.M_DISP_CAT_NM
--                     , S_DISP_CAT_NO = R_GOODS.S_DISP_CAT_NO
--                     , S_DISP_CAT_NM = R_GOODS.S_DISP_CAT_NM
--                     , D_DISP_CAT_NO = R_GOODS.D_DISP_CAT_NO
--                     , D_DISP_CAT_NM = R_GOODS.D_DISP_CAT_NM
  , RETRV_WD = R_GOODS.RETRV_WD
  , ADULT_GOODS_YN = R_GOODS.ADULT_GOODS_YN
  , DEL_YN = CASE
                 WHEN R_GOODS.SALE_STAT_CD = '130' OR R_GOODS.SALE_STAT_CD = '100' THEN 'Y'  --100:판매준비, 130:판매불가
                 WHEN (SELECT NVL(MAX(DECODE(MDA_CD, '110', 'Y')), 'N')
                       FROM   TB_PD_PRD_SL_IMPSS_CHNL  --노출채널여부
                       WHERE  PRD_ID = R_GOODS.GOODS_NO
                         AND    MDA_CD = '110'
                         AND    USE_YN = 'Y') = 'Y' THEN 'Y'
                 ELSE 'N'  --110:판매가능, 120:일시품절
    END
  , DLV_MTD_CD = R_GOODS.DLV_MTD_CD
  , BRND_ID = R_GOODS.BRND_ID
  , BRND_NM = R_GOODS.BRND_NM
  , MOD_DTIME = V_SYS_DTIME
  , ONL_GOODS_NM = R_GOODS.ONL_GOODS_NM
  , DEAL_APLY_STRT_DTIME = R_GOODS.DEAL_APLY_STRT_DTIME
  , DEAL_APLY_END_DTIME = R_GOODS.DEAL_APLY_END_DTIME
  , MAX_ORD_PSB_QTY = R_GOODS.MAX_ORD_PSB_QTY
  , INSD_RETRV_EXCL_YN = R_GOODS.INSD_RETRV_EXCL_YN
  , ONL_PRD_TYP_CD = R_GOODS.ONL_PRD_TYP_CD
  , MANPRD_PATTN_CD = R_GOODS.MANPRD_PATTN_CD
  , DLV_CHRC_CD = R_GOODS.DLV_CHRC_CD
  , MD_ID = R_GOODS.MD_ID
  , EMP_GOODS_YN = R_GOODS.EMP_GOODS_YN
  , EP_EXCL_YN  = R_GOODS.EP_EXCL_YN
  , MOBILE_DC_EXCL_YN  = R_GOODS.MOBILE_DC_EXCL_YN
  , EP_MOD_DTIME = V_SYS_DTIME
  , GOODS_SP_CD = R_GOODS.GOODS_SP_CD
  , MOBILE_PNM_EXCL_YN  = R_GOODS.MOBILE_PNM_EXCL_YN
  , COD_YN = R_GOODS.COD_YN
  , ONL_GOODS_RETRV_WD_1 = R_GOODS.ONL_GOODS_RETRV_WD_1
  , ONL_GOODS_RETRV_WD_2 = R_GOODS.ONL_GOODS_RETRV_WD_2
  , ONL_GOODS_RETRV_WD_3 = R_GOODS.ONL_GOODS_RETRV_WD_3
  , ONL_GOODS_RETRV_WD_4 = R_GOODS.ONL_GOODS_RETRV_WD_4
  , ONL_GOODS_RETRV_WD_5 = R_GOODS.ONL_GOODS_RETRV_WD_5
  , ONL_GOODS_RETRV_WD_6 = R_GOODS.ONL_GOODS_RETRV_WD_6
  , GOODS_SCT_CD = R_GOODS.GOODS_SCT_CD
  , GOODS_OPER_SP_CD = R_GOODS.GOODS_OPER_SP_CD
  , GOODS_CHRC_CD = R_GOODS.GOODS_CHRC_CD
WHERE  GOODS_NO = R_GOODS.GOODS_NO
;
/**
 * UPDATE TF_GOODS_RETRV_EXT
 */
UPDATE TF_GOODS_RETRV_EXT
SET
    TRDIT_MRKT_GOODS_YN         = R_GOODS_EXT.TRDIT_MRKT_GOODS_YN
  ,GOODS_PREP_SHOW_STRT_DTIME = R_GOODS_EXT.GOODS_PREP_SHOW_STRT_DTIME
  ,GOODS_PREP_SHOW_END_DTIME  = R_GOODS_EXT.GOODS_PREP_SHOW_END_DTIME
WHERE GOODS_NO = R_GOODS.GOODS_NO
;
V_U_CNT := V_U_CNT + 1;
ELSE
                    --INSERT MAYBE NEW GOODS
                    R_GOODS.REG_DTIME := V_SYS_DTIME;
                    R_GOODS.MOD_DTIME := V_SYS_DTIME;
                    IF R_GOODS.SALE_STAT_CD = '130' THEN
                        R_GOODS.DEL_YN := 'Y';
ELSE
SELECT NVL(MAX(DECODE(MDA_CD, '110', 'Y')), 'N')
INTO   R_GOODS.DEL_YN
FROM   TB_PD_PRD_SL_IMPSS_CHNL
WHERE  PRD_ID = R_GOODS.GOODS_NO
  AND    MDA_CD = '110'   /*인터넷*/
  AND    USE_YN = 'Y'
;
END IF;
BEGIN
SELECT MAX(DECODE(RNK, 1, DISP_CAT_NO)) AS L_DISP_CAT_NO
     , MAX(DECODE(RNK, 1, DISP_CAT_NM)) AS L_DISP_CAT_NM
     , MAX(DECODE(RNK, 2, DISP_CAT_NO)) AS M_DISP_CAT_NO
     , MAX(DECODE(RNK, 2, DISP_CAT_NM)) AS M_DISP_CAT_NM
     , MAX(DECODE(RNK, 3, DISP_CAT_NO)) AS S_DISP_CAT_NO
     , MAX(DECODE(RNK, 3, DISP_CAT_NM)) AS S_DISP_CAT_NM
     , MAX(DECODE(RNK, 4, DISP_CAT_NO)) AS D_DISP_CAT_NO
     , MAX(DECODE(RNK, 4, DISP_CAT_NM)) AS D_DISP_CAT_NM
INTO   R_GOODS.L_DISP_CAT_NO
    , R_GOODS.L_DISP_CAT_NM
    , R_GOODS.M_DISP_CAT_NO
    , R_GOODS.M_DISP_CAT_NM
    , R_GOODS.S_DISP_CAT_NO
    , R_GOODS.S_DISP_CAT_NM
    , R_GOODS.D_DISP_CAT_NO
    , R_GOODS.D_DISP_CAT_NM
FROM   (SELECT ROW_NUMBER() OVER(ORDER BY LEVEL DESC) AS RNK
                                     , A.DISP_CAT_NO
             , A.DISP_CAT_NM
        FROM   TF_DISP_CAT A
        WHERE  A.USE_YN = 'Y'
          AND    A.DISP_CAT_NO <> 20000
            START WITH A.DISP_CAT_NO = (
            SELECT DISP_CAT_NO
            FROM   TF_CAT_CLS_LNK
            WHERE  GOODS_CLS_ID = T_GOODS(idx).GOODS_CLS_ID
            )
        CONNECT BY PRIOR A.UPR_DISP_CAT_NO = A.DISP_CAT_NO )
;
EXCEPTION WHEN NO_DATA_FOUND THEN
                        NULL;
END;
