    --상품 동영상 등록 여부
BEGIN
        V_U_CNT := 0;
FOR IDX IN (
            SELECT DISTINCT PRD_ID
            FROM TB_PD_PRD_MOV
            WHERE MDF_DTM >= V_BATCH_STRD_DTIME
              AND MDF_DTM < V_SYS_DTIME
            ) LOOP
UPDATE TF_GOODS_RETRV_EXT GRE
SET    GRE.GOODS_VIDEO_REG_YN = (
    SELECT USE_YN
    FROM TB_PD_PRD_MOV A
    WHERE A.PRD_MOV_ID = ( SELECT MAX(PRD_MOV_ID) KEEP(DENSE_RANK FIRST ORDER BY PRD_MOV_ID DESC) AS MID FROM TB_PD_PRD_MOV WHERE PRD_ID = IDX.PRD_ID)
)
WHERE GOODS_NO = IDX.PRD_ID
;
