END LOOP;
COMMIT WORK;
V_EXE_RSLT := V_EXE_RSLT || ' 상품동영상여부변경:'||V_U_CNT;
END;
    V_EXE_RSLT_CD := 1;
    V_EXE_RSLT := '성공' || ' ' || V_EXE_RSLT;
    P_UPDATE_BATCH_EXE_HIS();
EXCEPTION WHEN OTHERS THEN
    ROLLBACK WORK;
    DBMS_OUTPUT.PUT_LINE ('err=' || SQLERRM);
