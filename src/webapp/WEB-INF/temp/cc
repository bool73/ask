	/* ### 특정날짜 요일 추출 함수 */
	, getDayOfWeek : function(dateStr) {
		let week = ['일', '월', '화', '수', '목', '금', '토'];
		if(dateStr.indexOf("-") == -1) {
			dateStr = dateStr.substring(0,4) + "-" + dateStr.substring(4,6) + "-" + dateStr.substring(6,8);
        }
		let dayOfWeek = week[new Date(dateStr).getDay()];
        return dayOfWeek;
	}
	
