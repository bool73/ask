<script type="text/javascript">
(function(){ let me = window.scheduleMainMgr = {
    
    /* ############################################################
    ##### 기본변수
    ############################################################ */
    selectedBrcType : "TV"               // 선택한 방송 타입(TV:TV쇼핑, MLC:공영라방)
    , selectedStdDate : ""             // 선택한 기준 날짜
    , swiperTimeNav : null             // 퀵메뉴 네비게이션 스와이퍼
    , imgServerUrl : "${view.imgServerUrl}"
    , imgProductPath : "${view.imgProductPath}"
    , isLiveWas : "${view.isLiveWas}"
    , scheduleApplyId : ""
    ,scheduleOrder : -1
    ,scheduleId : null
    ,CACHE_KEY : "CACHE_DATA"
    ,isSupportBFcache : false
    ,currentScheduleList : [] 
    /* ############################################################
    ##### 기본함수
    ############################################################ */
    ,clearCacheData : function (key){
        var cache = {
            data : null
        };
        $.cache(key,cache);
    }
    ,moveToSchedule(){
        try {
            setTimeout(function () {
                if (!me.isSupportBFcache && me.scheduleId != null) {
                    if (document.querySelector(me.scheduleId) != null) {
                        setTimeout(function () {
                            document.querySelector(me.scheduleId).scrollIntoView();
                        }, 100);
                    } else {
                        setTimeout(function () {
                            if (document.querSyelector(me.scheduleId) != null) {
                                document.querySelector(me.scheduleId).scrollIntoView();
                            }
                        }, 500);
                    }
                }
            });
        }catch (e){
            console.log("moveToSchedule method error!")
        }
    }
    /* ### 초기 실행 함수 */
    , init : function() {

        me.selectedStdDate = "${stdDate}"; //오늘 날짜
        let tvDate = me.selectedStdDate; //편성표 기준 날짜

        try {
            // 상단 탭 클릭 함수
            $("#tsMainTabs li").on('click', function() {
                $("#tsMainTabs li").find("a").removeClass("active");
                $(this).find("a").addClass("active");
            });

            // 로드시 옵션에 따라 탭설정 (공영라방 탭 -> 편성표 링크)
            let tabs = '<c:out value="${tabs}" />';
            if(tabs != null && tabs != '' && tabs == 'MLC'){
                me.selectedBrcType = "MLC";    // 초기 방송 유형은 공영라방
                $('#tsMainTabs li[gbn="MLC"]').trigger('click');
            }

            window.removeEventListener("pageshow", (e) => {});
            window.addEventListener("pageshow", (e) => {
                if (e.persisted) {
                    me.clearCacheData(me.CACHE_KEY);
                    me.isSupportBFcache = true;
                }
            });

            var cacheData = $.cache(me.CACHE_KEY);
            if(cacheData !=null && cacheData.data != null) {
                var data = cacheData.data;

                console.log(data)
                me.selectedBrcType = data.selectedBrcType;
                me.scheduleId = data.scheduleId;
                if('MLC' === me.selectedBrcType ){
                    //공영라방 탭
                    $('#tsMainTabs li[gbn="MLC"]').trigger('click');
                }

                tvDate = data.selectedStdDate; //캐시된 날짜 가져오기
                //캐시 데이터 초기화
                me.clearCacheData(me.CACHE_KEY);
            }
        }catch (e){
            console.log("cache data delete error!");
        }

       //날짜 유효성 체크
        if ( !moment(tvDate,"YYYYMMDD",true).isValid() ) {
            tvDate = me.selectedStdDate;
        }

        if(tvDate) {
        	$('#swiperDateNav .swiper-slide > a[data-date]').removeClass('active');
        	$('#swiperDateNav .swiper-slide > a[data-date="' + tvDate + '"]').addClass('active');
        	me.selectedStdDate = String(tvDate);   // 선택한 기준 날짜 저장
        	new DateNavBar();
        }

        $("#globalFooter").hide();

        // 초기 방송 유형은 TV쇼핑
        /*   if(me.isEmpty(me.selectedBrcType)){
               me.selectedBrcType = "MLC";
           }*/

        if (me.selectedBrcType == 'TV') {
            $("body").removeClass("ts-gylive").addClass("ts-tv");
        } else {
            $("body").removeClass("ts-tv").addClass("ts-gylive");
        }

        
        me.scheduleApplyId = "prdArea_" + me.selectedBrcType + "_" + me.selectedStdDate;
        if(me.selectedBrcType == 'TV') goodsUnitTool.removeApp(me.scheduleApplyId);	// 앱ID가 잔존하는 경우 삭제
        me.scheduleListAjax();
        
        $(document).on('scroll', function() {
            if(window.pageYOffset > 700) {
                $('.ts-quick').hide();
            } else {
                $('.ts-quick').show();
            }
        });

        //상품상세 이동시
        $(document).on("click","#tsPrdList .img-wrapper,#prdListScroll #tsPrdList .content-wrapper" , function() {

            let schedulePrd = $(this).parents(".time-box");
            let scheduleOrder = $(this).parents(".ts-daily-prd").find(".time-box").index(schedulePrd);
            let scheduleId = $(this).parents(".time-box").attr("id");

            let cache = {
                            data : {
                                'selectedStdDate' : me.selectedStdDate
                                ,'selectedBrcType': me.selectedBrcType
                                ,'scheduleOrder' : scheduleOrder
                                ,'scheduleId' : "#" + scheduleId
                            }
                        };
            $.cache(me.CACHE_KEY,cache);
        });

        
      /*  $('#gnbTab').find('.dv-gnb > li').on('click', function() {
            console.log("  remove tvScheduleDate")
            sessionStorage.removeItem('tvScheduleDate');
       		if($('#scheduleSearch').css('display') != 'none') me.cloaseScheduleSearch();
       		$('#gnbTab').find('.dv-gnb > li').off('click');
        });*/
        
        // 목록 초기화 진행
        me.initAppPrdList();
    }
    
    /* ### 편성표 방송 유형 기준 검색 함수 */
    , searchBrcTypeScheduleProc : function(type) {
        me.selectedBrcType = type;   // 선택한 방송 유형 저장
        me.scheduleApplyId = "prdArea_" + me.selectedBrcType + "_" + me.selectedStdDate;
        // 첫 로드시 init과 중복 호출로 다음과 같은 조건부 추가
        if (me.selectedStdDate != null && me.selectedStdDate.length > 0) {
        	me.scheduleListAjax();
        }
        
        //$(".dv-quickArea").remove();
    }
    
    /* ### 편성표 날짜 기준 검색 함수 */
    , searchDateScheduleProc : function(date) {
        me.scheduleId = null // 초기화
    	let todayDate = dateTool.getCurrentDate("yyyyMMdd");
    	let applyId = "";
    	commonTool.wait.show('timeClose');
    	
    	if(me.selectedBrcType == "TV") {
    		applyId = $("#prdArea_TV_" + date).find(".time-box").attr("id");
    	} else {
    		applyId = $("#prdArea_MLC_" + date).find(".time-box").attr("id");
    	}

    	if(todayDate == date || typeof applyId == "undefined") {
            console.log("11  "+date);
            //sessionStorage.setItem('tvScheduleDate', date);
            me.selectedStdDate = String(date);   // 선택한 기준 날짜 저장
            me.scheduleApplyId = "prdArea_" + me.selectedBrcType + "_" + me.selectedStdDate;
            //goodsUnitTool.removeApp(me.scheduleApplyId);	// 앱ID가 잔존하는 경우 삭제
            if(me.selectedBrcType == "TV") goodsUnitTool.clearTimer(me.scheduleApplyId);
            me.scheduleListAjax();
            commonTool.wait.hide();
    	} else {
    	    console.log("22  "+date);
            //sessionStorage.setItem('tvScheduleDate', date);
            me.selectedStdDate = String(date);   // 선택한 기준 날짜 저장
            me.scheduleApplyId = "prdArea_" + me.selectedBrcType + "_" + me.selectedStdDate;
    		me.scheduleHtmlProc();
    		commonTool.wait.hide();
			let quickTimeNavId = "quickTimeNav_" + me.selectedStdDate;
            $(".dv-quickArea .ts-quick-timenav").hide();
            $(".dv-quickArea").find("#" + quickTimeNavId).show();
    	}
    	
    	
    	UI.waFocus("#"+me.scheduleApplyId); // 접근성 개선
    	
    }
    
    /* ### 편성표 목록 ajax */
    , scheduleListAjax : function() {
        $("#tsPrdList").hide();
        $("#tsPrdEmpty").hide();
        $("#tsPrdList > div").hide();
        $("#tsPrdList > div").removeClass("active");
        
        let url = "";
        let dataJson = {};  // dataJson 구성
        
        if(me.selectedBrcType == "MLC") {
            url = "/mlc/selectMlcSchedulePrdList.do";
            dataJson.cacheType = "SCHEDULE";
        } else if(me.selectedBrcType == "TV") {
            url = "/tvshopping/selectScheduleSub.do";
        }
        
        dataJson.brcStdDate = me.selectedStdDate;
        
        $.ajax({
              url : url
            , type : "POST"
            , dataType : "json"
            , data : dataJson
            , success : function(result) {
            	//console.log(result);
                me.getScheduleData(result);
            }
            , fail : function(data,status,err){
                console.log(textStatus);
                console.log(err);
            }
        });
	}
	/* app list 초기화 */
	, initAppPrdList: function(){
		// 유닛 초기화
		$('#prdListScroll div.ts-daily-prd').each(function(){
			let id = $(this).attr('id');
			//console.log('id='+id);
			if(!me.isEmpty(id)){
				if(id.indexOf('prdArea_TV') > -1){
					goodsUnitTool.setOptions(id, {"includeBrdCstTgtPrd" : true, "isSlStsCd130" : true});	
				}else{
					mlcUnitTool.setOptions(id, {"includeBrdCstTgtPrd" : true});
				}
			}
		});
		
	}
	/* ### 편성표 데이터 구성 */
	, getScheduleData : function(data) {

		// 퀵메뉴 별도 활성화 처리
		if(me.selectedBrcType == "MLC") {
            $(".dv-quickArea .ts-quick-timenav").hide();
        }
				
		if (data.prdList.length > 0) {
            let dataCopy = {};
            $.extend(true,dataCopy,data);

            let scheduleListMap = [];
            let scheduleMap = {};
            let prdSet = 0;
            let isFirstPrd = false;
            
            // ##################################### TV쇼핑 데이터 구성
            if(me.selectedBrcType == "TV") {
                let brcPgmSchdgId = "";
                
                for (var i = 0; i < dataCopy.prdList.length; i++) {
                    let scheduleData = dataCopy.prdList[i];
                    
                    // jmh 추가
                    if( "Y" == scheduleData.obzYn ){
                        me.obzScheduleId = "schedulePrd_" + scheduleData.brcPgmSchdgId;
                    }
                    
                    if (brcPgmSchdgId != scheduleData.brcPgmSchdgId) {
                        brcPgmSchdgId = scheduleData.brcPgmSchdgId;
                        prdSet++;
                        scheduleMap[prdSet + "_" + brcPgmSchdgId] = [];
                        isFirstPrd = true;
                    } else {
                        isFirstPrd = false;
                    }

                    let tgtPrdInfo = scheduleData.tgtPrdInfo;
                    if(tgtPrdInfo !=null){
                        Object.keys(tgtPrdInfo ).forEach(function(key){
                            if(key != "brcBgnDtm") {
                                scheduleData[key] = scheduleData.tgtPrdInfo[key];
                            }
                        })
                    }

                    scheduleData.isFirstPrd = isFirstPrd;
                    scheduleMap[prdSet + "_" + brcPgmSchdgId].push(scheduleData);
                }
                
                // 현재일자 (년월일시분)
                let nowTime = dateTool.getCurrentDate('yyyyMMddHHmm');
                // jmh 추가 테스트용
               /* let nowTime = 202609212140;
                console.log(" 현재시간 "+dateTool.getCurrentDate('yyyyMMddHHmm'));
                let queryString = window.location.search,
                urlParams = new URLSearchParams(queryString);
                
                if( "0" != urlParams.get("cnt")){
                     nowTime = 202609211010;
                }*/
                
                
                
                
                
                Object.keys(scheduleMap).forEach(function(key) {
                    let schedulePrdListData = scheduleMap[key];
                    let currentDtm = nowTime;
                    let searchBrcBgnDtm = schedulePrdListData[0].brcBgnDtm;
                    let searchBrcEndDtm = schedulePrdListData[0].brcEndDtm;
                    let isOnAir = currentDtm >= searchBrcBgnDtm && currentDtm < searchBrcEndDtm;
                    let isPreOrder = currentDtm < searchBrcBgnDtm   ? true : false;
                    let prdId = "";
                    let prdCstTgtPrdList = [];
                    
                    // 대표상품, 함께하는 상품 구분처리
                    $.each(schedulePrdListData, function(index, item){
                         prdCstTgtPrdList.push(item);
                    });
                    /*
                    let jsonData = {
                        brcPgmSchdgId : key.split("_")[1]                  // 방송 프로그램 편성표 ID
                        //, prdList : schedulePrdListData
                        , currentDtm : currentDtm
                        , brcBgnDtm : schedulePrdListData[0].brcBgnDtm     // 방송 시작 일시
                        , brcEndDtm : schedulePrdListData[0].brcEndDtm     // 방송 종료 일시
                        , searchPrd: isOnAir ? 'CURRENT' : (isPreOrder ? 'NEXT' : 'PREV')
                        , prdId : prdId
                        , prdCstTgtPrdList : prdCstTgtPrdList
                        , prdLclsNm : schedulePrdListData[0].prdLclsNm
                        , obzYn : schedulePrdListData[0].obzYn
                        , obzFileUrl : me.imgServerUrl.replace("ECMCFO", "") + schedulePrdListData[0].omzFileNm
                        , prdImgUrl : me.imgProductPath + schedulePrdListData[0].imgUrl
                        , brcPgmNm : schedulePrdListData[0].brcPgmNm
                    };*/
                    let jsonData = {};
                    $.extend(true,jsonData,schedulePrdListData[0]);
                    jsonData.goodsUnitInfoDone = true;
                    jsonData.obzFileUrl = me.imgServerUrl.replace("ECMCFO", "") + jsonData.omzFileNm
                    jsonData.brdCstTgtPrdList =  prdCstTgtPrdList ;
                    jsonData.searchPrd = isOnAir ? 'CURRENT' : (isPreOrder ? 'NEXT' : 'PREV');
                    jsonData.prdImgUrl =   jsonData.imgUrl !=null ? me.imgProductPath + jsonData.imgUrl : '';
                    scheduleListMap.push(jsonData);
                })
                
                //console.log("scheduleListMap ::: ", scheduleListMap);
                let prdIdList = [];
                $.each(scheduleListMap, function (idx, prd) {
                    let obj = {idx: idx, prdId: prd.prdId};
                    prdIdList.push(obj);
                })

