        UI.waFocus(".btn.-openScheduleSearch"); // 접근성 개선
    }
	
    /* ### 편성표 검색 이동 */
    , goScheduleSearch : function() {
        
        let searchKwd = $("#scheduleSearchKwd").val();
        
        if(searchKwd == "") {
            commonTool.alert("검색어를 입력해 주세요.").done(function() {
                $("#scheduleSearchKwd").focus();
            });
            return;
        }
        
        if(/[\{\}\/?;:|\)*~`!^\<>@\#$%&\\\=\(\'\"]/gi.test(searchKwd)) {
            commonTool.alert('입력하신 키워드 단어에 <br/> 특수문자가 들어가 있습니다!').done(function() {
            	$("#scheduleSearchKwd").focus();
            });
            return;
        }
        
        location.href = "/tvshopping/tvScheduleSearch.do?searchKeyword=" + searchKwd;
        
    }
    
    /* ### 편성표 라이브 스크롤 이동 함수 */
    , goScheduleLive : function(type) {
    	
    	// GNB영역 최소화
        if($('body').hasClass('gy-home')) $('body').removeClass('gy-home');
        if($('body').hasClass('has-top-app')) $('body').removeClass('has-top-app');
        GyGnb.close();
    	
        // 방송 노출
    	let currentDate = dateTool.getCurrentDate('yyyyMMdd');
    	$("#swiperDateNav div.swiper-slide").each(function(){
    		let date = $(this).find("a").data("date");
    		if(currentDate == date) {
    		    me.selectedBrcType = type;   // 선택한 방송 유형 저장
    		    $("#tsMainTabs li").find("a").removeClass("active");
    		    if(type == "MLC") {
    		    	$('#tsMainTabs li[gbn="MLC"]').find("a").addClass("active");
    		    	$("body").removeClass("ts-tv");
    		    	$("body").addClass("ts-gylive");
    		    } else {
                    $('#tsMainTabs li[gbn="TV"]').find("a").addClass("active");
                    $("body").removeClass("ts-gylive");
                    $("body").addClass("ts-tv");
    		    }
    		    
    		    $(this).find("a").trigger('click');
    		    
    		    return;
    		}
    	});
    	
    } 
	
	
    /* ############################################################
    ##### UI 관련 함수
    ##### - UI 편성표 하단 편성표시간표 네비게이션, 상품리스트 위치활성화 스크립트
    ##### - 화면 랜딩시 라이브 상품,시간표 위치 활성화
    ##### - case: 편성된 상품이 없을 경우 라이브상품 활성화 스크립트 실행 안함
    ############################################################ */
    
    /* ### 시간표 스크롤 이동 함수 */
    , scrollToMove : function(idx, _duration) {
    	console.log('scrollToMove');
        var scrollTop = $(".dv-goodsIdx_" + (parseInt(idx)-1)).position().top;
        var duration = (_duration === 'undefined')? 'smooth' : 'instant';
        document.querySelector('#prdListScroll').scrollTo({top: scrollTop, behavior: duration});
        UI.waFocus(".dv-goodsIdx_" + (parseInt(idx)-1)); // 접근성 개선
        return false;
    }
    
    /* ### 편성표 상품 위치 활성화 */
    , prdListTo : function(id, _duration) {
        var idSelector = '#' + id;
        var scrollTop = $(idSelector).position().top;
        console.log(idSelector+" top : "+scrollTop)
        var duration = (_duration === 'undefined')? 'smooth' : 'instant';
        document.querySelector('#prdListScroll').scrollTo({top: scrollTop, behavior: duration});
    }
    
    /* ### 편성표 시간표 위치 활성화 */
    , timeNavTo : function(id) {
        var idSelector = '#' + id;
        var slideIndex = $('#swiperTimeNav_' +  me.selectedStdDate).find('[href="' + idSelector +'"]').parent().data('index');
        $('#swiperTimeNav_' +  me.selectedStdDate).find('.timenav-link').removeClass('active');
        $('#swiperTimeNav_' +  me.selectedStdDate).find('.swiper-slide').eq(slideIndex).find('.timenav-link').addClass('active');
        me.swiperTimeNav.slideTo(slideIndex);
    }
    
    /* ### 상품영역 스크롤 이벤트 핸들러: 편성표(시간표 네비) 위치 활성화 */
    , prdlistScrollHandler : function() {
        
        // 상품유닛 및 상품이미지 수동호출
        goodsUnitTool.loadUnitInfo();
        imageCdnMng.imgAct();
        
        var toId = $('#prdListScroll .active .time-box').eq(0).attr('id');
        $('#prdListScroll .active .time-box').each(function() {
            if($(this).position().top - $('#prdListScroll').scrollTop() < 10) {
                toId = $(this).attr('id');
            }
        });
        me.timeNavTo(toId);
    }
    
    , isEmpty: function(v){ return (typeof(v)=='undefined' || v == '' || v == null)? true : false; }
}})();

$(document).ready(function(){
    
